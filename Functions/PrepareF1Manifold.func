%%%%%%%%%%% pump out of F=2 using probe cooling 2-2'' %%%%%%%%%%%
def PrepareF1Manifold():
    on: PrbShutter
    on: PrbCoolShutter
    off: xyzMOTShutter
    off: D1LGMShutter
    off: D1LGMPrbShutter
    off: PrbRepTrg
    ol: ol_cooling d2_cooling_prb_resonance-(28.8-266.65) %28.8
    ol: ol_repump d2_repump_prb_resonance+(28.8+266.65+30) % detuned on purpose
    dac: PrbRepAmp 0.0
    dac: PrbAmp 1
    t += t_shutter

    on: PrbTrg
    t += 0.5 %0.05 
    off: PrbTrg
    off: PrbRepTrg
