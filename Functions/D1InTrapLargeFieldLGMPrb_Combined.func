def D1InTrapLargeFieldLGMPrb_Combined():
    repeat: is_cryo
    %%%%%%%%%%%%%%%%% large field LGM optimzied at cryo %%%%%%%%%%%%%%%%
    t += 10
    call D1InTrapLargeFieldLGMPrb_Cryo(-8.955)
    %%%%%%%%%%%%%%%%% large field LGM optimzied at cryo %%%%%%%%%%%%%%%%
    end

    repeat: 1-is_cryo
    %%%%%%%%%%%%%%%% large field LGM optimized at RT %%%%%%%%%%%%%%%%
    t += 10
    call D1InTrapLargeFieldLGMPrb_RT(-7.62) %-7.6
    %%%%%%%%%%%%%%%% large field LGM optimized at RT  %%%%%%%%%%%%%%%%
    end
