%%%%% push out F=2 using 2-3'', using OP beam %%%%%
def StateSelectivePushout(Bfield):
%    dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
%%    t += 10
%    off: TARepShutter
%    off: PrbShutter
%    off: xyzMOTShutter
%    off: D1LGMShutter
%    off: D1LGMPrbShutter
%    on: OPShutter
%    ol: ol_cooling d2_cooling_resonance-(12.7) 
%    ol: ol_repump d2_repump_resonance+20 % intensional detuned
%    %dac: TARepAmp 3
%    dac: OPAmp {0.1 op_pwr} %0.1
%    t += 10 %t_shutter
%    on: OPTrg
%    t += 0.05 %0.2
%    off: OPTrg
%    off: OPShutter
%    t += 1-0.05 %time_scan 
%    dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10 
%    t += 10

    var FullTrapLightShift 26.4 %30 % MHz
    %var Bfield 3.5 %G
    var DifferentialZeemanCoef 1.4 % MHz/G
    var PushoutTrapFraction 0.115 %0.1
    var PushoutTime 0.01 %ms
    dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*PushoutTrapFraction 10
    off: TARepShutter
    off: PrbShutter
    off: xyzMOTShutter
    off: D1LGMShutter
    off: D1LGMPrbShutter
    on: OPShutter
    ol: ol_cooling d2_cooling_resonance-(FullTrapLightShift*PushoutTrapFraction+DifferentialZeemanCoef*Bfield) %(7.3) 
    ol: ol_repump d2_repump_resonance+20 % intensional detuned

    dac: OPAmp {0.1 op_pwr} %0.1
    t += 10 %t_shutter

    t += 0.05 % wait for trap depth to settle
    on: OPTrg
    t += PushoutTime %time_scan %0.05
    off: OPTrg
    off: OPShutter
    t += 0.05-PushoutTime
    on: TARepShutter 
    dacramp: SLMTweezerIntensity slm_twz_intensity*PushoutTrapFraction slm_twz_intensity 10 
    t += 10


