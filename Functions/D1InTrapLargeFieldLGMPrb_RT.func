%%%%%%%%%%%%%%%%% large field LGM optimized at RT %%%%%%%%%%%%%%%%
def D1InTrapLargeFieldLGMPrb_RT(two_photon_detuning):
    off: xyzMOTShutter
    on: D1LGMPrbShutter
    off: D1LGMShutter
    on: D1LGMEOMTrg
    dac: D1LGMEOMAmp 0 %amplitude_scan %d1lgmprb_twz_rep_amp
    dac: D1LGMAmp {4.5 d1lgm_prb_pwr} % amplitude_scan%d1lgmprb_twz_cool_amp
    ol: ol_D1LGM D1_LGMCooling_resonance-230 %resonance_scan %d1lgm_twz_olcool
    ol: ol_D1_repump Rb87_HFSplitting+(two_photon_detuning) %(-7.6) %4.5 %resonance_scan %d1lgm_twz_olrepump

    dac: BiasCoilX pgc_twz_bias_x %-1.75 %pgc_twz_bias_x
    dac: BiasCoilY -4.5 %pgc_twz_bias_y %-5 %pgc_twz_bias_y=-4.5
    dac: BiasCoilZ pgc_twz_bias_z %pgc_twz_bias_z
    t += t_shutter

    on: D1LGMTrg
    t += 25 %time_scan %t_lgm_cool_time 
    pulseon: DO1_0 1
    off: D1LGMTrg
    off: D1LGMEOMTrg
    off: D1LGMShutter
    off: D1LGMPrbShutter

    t += 1
    dac: BiasCoilX pgc_twz_bias_x 
    dac: BiasCoilY pgc_twz_bias_y
    dac: BiasCoilZ pgc_twz_bias_z
