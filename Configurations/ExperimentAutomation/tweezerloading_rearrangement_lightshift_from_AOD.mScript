%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()


t += -250

% SLM image
pulseon: Mako2 0.01
t += 1.1

pulseon: GMLoadTrg 0.0005
dac: TweezerIntensity 6.0 
t += 1

% AOD full array image
pulseon: Mako2 0.01 
t += 0.2
pulseon: TweezerTrg 0.04
t += 1.1


% holding the tweezer at amplitude_scan
dac: TweezerIntensity 0.4
t += 0.5
on: TweezerTrg
%pulseon: Mako2 0.01 
t += 10.2
on: TweezerHold
t += 0.1
off: TweezerTrg
t += 250-1.1-1-0.2-1.1-0.5-10.2-0.1


%%%%%%%%%%%%%%%  TOF  %%%%%%%%%%%%%%%%%%
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 15

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser fre q parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 15

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
t += 15 




%


t += 10
call D2InTrapPGCPrb(25)



call setZeroField()
t += 100 %750

t += 15
%%%%%%%%%%% pump out of F=1 using probe repump 1-2'' %%%%%%%%%%%
call PrepareF2Manifold()




%%%%% push out F=2 using 2-3'', using OP beam
off: TARepShutter
off: PrbShutter
off: xyzMOTShutter
off: D1LGMShutter
off: D1LGMPrbShutter
on: OPShutter
ol: ol_cooling d2_cooling_resonance-resonance_scan %(5) %resonance_scan %(2.5) %(5) %(1.5) %(4)  %3(-3) %20 %resonance_scan %(28.8)
ol: ol_repump d2_repump_resonance+20 %resonance_scan %(28.8) %(28.8+266/2) %resonance_scan % % intensional
%dac: TARepAmp 3
dac: OPAmp {0.1 op_pwr} %0.1
t += t_shutter

var SLM_depth 3.5
dacramp: SLMTweezerIntensity slm_twz_intensity SLM_depth 10
t += 10

on: TweezerTrg
pulseon: do8_4 0.01
t += 0.1
on: OPTrg
t += 0.065 %time_scan %0.10 %0.05
off: OPTrg
off: OPShutter
t += 0.1-0.065 %time_scan %0.05 %
off: TweezerTrg
dacramp: SLMTweezerIntensity SLM_depth slm_twz_intensity 10
t += 10

off: TweezerHold

call TrapLowerAndRiseSLM(slm_twz_intensity, slm_twz_intensity*0.1, 10, 15)

t += 1


%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 15
%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval
call PGCTweezerImaging()

t += 10

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
pulseon: DO1_0 0.5
