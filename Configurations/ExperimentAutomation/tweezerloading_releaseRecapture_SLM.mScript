%    off: D1LGMShutter
%    off: D1LGMPrbShutter
%%%%%%%%%%%%%%%%% LGM for full NA cryo %%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%% LGM for full NA RT %%%%%%%%%%%%%%%%
t += 10
    off: xyzMOTShutter
    on: D1LGMPrbShutter
    off: D1LGMShutter
    on: D1LGMEOMTrg
    dac: D1LGMEOMAmp 0 %amplitude_scan %d1lgmprb_twz_rep_amp
    dac: D1LGMAmp {4.5 d1lgm_prb_pwr} %3% amplitude_scan%d1lgmprb_twz_cool_amp
    ol: ol_D1LGM D1_LGMCooling_resonance-230 %resonance_scan %200-cryo %150-RT %resonance_scan %d1lgm_twz_olcool
    ol: ol_D1_repump Rb87_HFSplitting+(-7.6) %(-8.9) %resonance_scan %4.5 %resonance_scan %d1lgm_twz_olrepump
    dac: BiasCoilX pgc_twz_bias_x %pgc_twz_bias_x_scan %-1.75 %pgc_twz_bias_x %0.8-RT
    dac: BiasCoilY -4.5 %pgc_twz_bias_y %pgc_twz_bias_y_scan %-5 %pgc_twz_bias_y=-4.5 %-1.1 RT
    dac: BiasCoilZ pgc_twz_bias_z %pgc_twz_bias_z_scan %pgc_twz_bias_z %-0.05RT

    t += t_shutter

    on: D1LGMTrg
    t += 25 %time_scan %25 %time_scan %t_lgm_cool_time 
    pulseon: DO1_0 1
    off: D1LGMTrg
    off: D1LGMEOMTrg
    off: D1LGMShutter
    off: D1LGMPrbShutter
%%%%%%%%%%%%%%%%% LGM for full NA RT %%%%%%%%%%%%%%%%


%%%%%%%%%%%%%%  Kickout TWIZZER  %%%%%%%%%%%%%%%%%%
%call kickOutTweezer()
%call TrapLowerAndRise(twz_intensity, twz_intensity*0.1, 10, 15)
%dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*fraction_scan 10  %fraction_scan
%dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.02 10
t += 10
%call ReleaseRecaptureSLM(t_twz_release)

t += 0.5
on: SLMTweezerHold
t += 0.1 % needed to allow actuation of shutters
on: DO8_4
off: SLMTweezerTrg % switcEh off the intensity
t += time_scan_us/1000 %20/1000 %time_scan_us/1000 %50/1000 %20/1000 %20/1000 %time_scan_us/1000 
on: SLMTweezerTrg % turn on the trigger again
t += 0.1
off: SLMTweezerHold
off: DO8_4
t += 0.5

%pulseon: DO8_4 0.1
%t += 10
%dacramp: SLMTweezerIntensity slm_twz_intensity*fraction_scan slm_twz_intensity 10 %fraction_scan
%dacramp: SLMTweezerIntensity slm_twz_intensity*0.02 slm_twz_intensity 10
t += 10 

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
    dac: BiasCoilX pgc_twz_bias_x
    dac: BiasCoilY pgc_twz_bias_y 
    dac: BiasCoilZ pgc_twz_bias_z 
t += 100
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval. change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
%on: MOTFlashTrg


t += 200
call PGCTweezerImaging()


%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
call EndSequence()
pulseon: DO1_0 0.5







