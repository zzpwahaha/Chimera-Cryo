%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()

%call CryoMOTEnhancedLoadingLGM()
    call MOTLoading(t_loading)
%%%%% this should be only callled after MOT loading function
%%%%% the first t += -10 is necessary to make sure the FreeSpaceLGM will start right after MOT loading so that we don't lose atom
%%%%% and the fucntion after this should be at least 10ms for the ramp to complete
%%%%% and a 10ms TOF is the best

%def FreeSpaceLGMEnhancedLoading():
    t += -10
    dacramp: TweezerIntensity twz_intensity twz_intensity*0.88 10
    dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.88 10 %0.88
%    dacramp: SLMTweezerIntensity 1.2 1.2*0.88 10
    t += 10

%    call FreeSpaceLGM(200) %time_scan %200 %FreeSpaceLGM start after 10ms for shutter to open, so put it here so that it start right after MOT
    t += -t_shutter
    % zero the light amplitude to avoid leakage and turn on shutter
    on: D1LGMShutter
    on: D1LGMPrbShutter
    on: xyzMOTShutter
    on: D1LGMEOMTrg
    dac: D1LGMEOMAmp 0 
    dac: D1LGMAmp 0 
    ol: ol_D1LGM D1_LGMCooling_resonance-d1lgm_olcool
    ol: ol_D1_repump Rb87_HFSplitting+d1lgm_olrepump
    t += t_shutter
    off: SciMOTTrg
    dac: SciMOTAmp 0 % this is necessary to reduce the leakage, since don't want to turn off shutter
    dac: TARepAmp 0
    dac: D1LGMEOMAmp d1lgm_rep_amp
    dac: D1LGMAmp d1lgm_cool_amp
%    off: xyzMOTShutter 
    dac: BiasCoilX pgc_bias_x
    dac: BiasCoilY pgc_bias_y 
    dac: BiasCoilZ pgc_bias_z

    on: D1LGMTrg
    t += 10 % cool at high intensity for 10ms
    dacramp: D1LGMAmp d1lgm_cool_amp 3 5 % ramp down amplitude in 5ms to get lower temperature but more atom
    t += 5+5 % hold at low intensity for 5ms
    t += 200-(10+5+5)
    off: D1LGMTrg
    off: D1LGMEOMTrg

    pulseon: DO1_0 1



%repeat: is_cryo
%% below is for cryo
%    t += -200
%    t += 40
%    dac: BiasCoilX 2 %shift_bias_x
%    dac: BiasCoilY -1.5 %shift_bias_y
%    dac: BiasCoilZ 0.05
%    t += 40
%    dac: BiasCoilX 1.5 %shift_bias_x
%    dac: BiasCoilY -1 %shift_bias_y
%    dac: BiasCoilZ 0.05
%    t += 40
%    dac: BiasCoilX 1.1
%    dac: BiasCoilY -1.2
%    dac: BiasCoilZ 0.05
%    t += 40
%    dac: BiasCoilX 0.9
%    dac: BiasCoilY -1.1
%    dac: BiasCoilZ 0.05
%    t += 40
%% above is for cryo
%end
    dacramp: TweezerIntensity twz_intensity*0.88  twz_intensity 10
    dacramp: SLMTweezerIntensity slm_twz_intensity*0.88  slm_twz_intensity 10 %0.88
%    dacramp: SLMTweezerIntensity 1.2*0.88  1.2 10




%    call MOTLoadingAOD(t_loading)	
%    call FreeSpaceLGMEnhancedLoading()
%
%	call MOTLoadingAOD(t_loading)	
%	call FreeSpacePGC(t_pgc_cool_time)

call TOF(10)

%%%%%%%%%%%%%%%  TOF  %%%%%%%%%%%%%%%%%%
%call TOF(t_tof)

%dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.2 10
%t += 100
%
%dacramp: SLMTweezerIntensity slm_twz_intensity*0.2 slm_twz_intensity 10
%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on

%dacramp: SLMTweezerIntensity slm_twz_intensity 0.59 10
%t += 10


call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz


t += 10
%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
%on: MOTFlashTrg
%dacramp: TweezerIntensity twz_intensity twz_intensity*fraction_scan 10
%%t += 10
%t += time_scan %100
%dacramp: TweezerIntensity twz_intensity*fraction_scan twz_intensity 10
%t += 10
t += 100
%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz


call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()


%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
pulseon: DO1_0 0.5

