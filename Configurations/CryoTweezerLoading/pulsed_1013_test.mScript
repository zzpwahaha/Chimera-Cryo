%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()

t += -250-200 % 200 ms is for LGM loading/cooling
% holding the tweezer at amplitude_scan
dac: TweezerIntensity 3 %4.3/37*20 %4.3/37*15 %1.2 %5.5 %twz_intensity %amplitude_scan %6.5
t += 0.5
on: TweezerTrg
%pulseon: Mako2 0.01 
t += 150.2
on: TweezerHold
t += 0.1
off: TweezerTrg
t += 250+200-0.5-150.2-0.1


call TOF(10)

%t += -10
%dacramp: SLMTweezerIntensity 1.2 slm_twz_intensity 10
%t += 10

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 15
%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser fre q parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 15
%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()


%%%%%%%%%%%%%%%%%%%%%%%  rearrangement  %%%%%%%%%%%%%%%%%%%% 
t += 50+50
%%%%%%%%%%% PGC %%%%%%%%%%% 
    dac: BiasCoilX pgc_twz_bias_x
    dac: BiasCoilY pgc_twz_bias_y 
    dac: BiasCoilZ pgc_twz_bias_z

    ol: ol_cooling d2_cooling_resonance+20-pgc_twz_olcool
    ol: ol_repump d2_repump_resonance-20+pgc_twz_olrepump
    on: PrbRepTrg
    on: PrbShutter
    on: PrbCoolShutter
    off: xyzMOTShutter
    dac: PrbAmp {pgcprb_twz_cool_amp_cal prb_pwr} 
    dac: PrbrepAmp pgcprb_twz_rep_amp
    t += t_shutter
%%%%%%%%%%% PGC %%%%%%%%%%% 

var rearrange_SLM_depth 5.8
dacramp: SLMTweezerIntensity slm_twz_intensity rearrange_SLM_depth 10  %slm_twz_intensity*fraction_scan
t += 10
% this turns off RF tones from load2
t += -1
pulseon: GMMoveTrg 0.0005
t += 1

repeat: 5
t += 0.01
% initialize tones
pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
t += 0.3

% move tones
on: PrbTrg
t += 0.01
on: TweezerTrg 
t += 0.01
pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
t += 5 %1.5 %5
off: TweezerTrg
t += 0.01
off: PrbTrg

% ramp down tones
pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
t += 0.3
end


%%% optional filtering
off: TweezerHold
pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
t += 0.3

on: PrbTrg
t += 0.01
on: TweezerTrg 
t += 0.01
pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
dacramp: SLMTweezerIntensity rearrange_SLM_depth 1.75 5
t += 5
%off: SLMTweezerTrg
t += 5 %1.5 %5
%on: SLMTweezerTrg
dacramp: SLMTweezerIntensity 1.75 rearrange_SLM_depth 5
t += 5
%t += time_scan
off: TweezerTrg
t += 0.01
off: PrbTrg
off: D1LGMTrg

pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
t += 0.3
%%% optional filtering


% after all rearrangement, this would turn off GM completely
%pulseon: GMMoveTrg 0.0005
off: TweezerTrg
off: PrbTrg
off: PrbShutter
t += 1
off: TweezerHold
pulseon: GMLoadTrg 0.0005

dacramp: SLMTweezerIntensity rearrange_SLM_depth slm_twz_intensity 10 %slm_twz_intensity*fraction_scan 
t += 10


%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval
call PGCTweezerImaging()

%%%%%%%%%%%%%%%%%%%%%  rearrangement  %%%%%%%%%%%%%%%%%%%% 

%%%%%%%%%%%%%%%%% large field LGM optimzied at cryo %%%%%%%%%%%%%%%%
t += 10
    off: xyzMOTShutter
    on: D1LGMPrbShutter
    off: D1LGMShutter
    on: D1LGMEOMTrg
    dac: D1LGMEOMAmp 0 %amplitude_scan %d1lgmprb_twz_rep_amp
    dac: D1LGMAmp {4.5 d1lgm_prb_pwr} %3% amplitude_scan%d1lgmprb_twz_cool_amp
    ol: ol_D1LGM D1_LGMCooling_resonance-230 %resonance_scan %200-cryo %150-RT %resonance_scan %d1lgm_twz_olcool
    ol: ol_D1_repump Rb87_HFSplitting+(-8.95) %(-8.92) %(-9.0) %(-8.9) %resonance_scan %4.5 %resonance_scan %d1lgm_twz_olrepump

    dac: BiasCoilX pgc_twz_bias_x %0.8-RT
    dac: BiasCoilY pgc_twz_bias_y %pgc_twz_bias_y_scan %-5 %pgc_twz_bias_y=-4.5 %-1.1 RT
    dac: BiasCoilZ pgc_twz_bias_z %pgc_twz_bias_z_scan %pgc_twz_bias_z %-0.05RT
    t += t_shutter

    on: D1LGMTrg
    t += 25 %time_scan %25 %time_scan %t_lgm_cool_time 
    pulseon: DO1_0 1
    off: D1LGMTrg
    off: D1LGMEOMTrg
    off: D1LGMShutter
    off: D1LGMPrbShutter
%%%%%%%%%%%%%%%%% large field LGM optimzied at cryo %%%%%%%%%%%%%%%%



%%%%%%%%%%%%%%%% bias field and OP %%%%%%%%%%%%%%%%
t += 5
call setQuantizationField()
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.02 10
t += 10
t += t_field_settling-20
dacramp: SLMTweezerIntensity slm_twz_intensity*0.02 slm_twz_intensity 10
t += 10
call OpticalPumping22()
%%%%%%%%%%%%%%%% bias field and OP %%%%%%%%%%%%%%%%


%%%%%%%%%%%%%%  Prepare Rydberg beams %%%%%%%%%%%%%%%%%%
var zero1013SetPoint -0.01
%var ryd1013SetPoint 4.0 %4.0 %2.0

on: Ryd1013Shutter
ddsfreq: Ryd420Brimrose ryd420_resonance
t += 5
%on: Ryd420Shutter
off: Ryd420ExpShutter
%on: Ryd1013Shutter
on: ryd420RFSourceSwitch
off: ryd420AWGShapedChSwitch

dac: Ryd420Amp ryd420_amplitude %0.11 %0.11 %0.05 %0.2 %amplitude_scan %0.8 %0.1 %0.55 %0.30 %0.34
dac: Ryd1013Amp zero1013SetPoint %2.0 %0.55 %0.60 %0.68

var IQ_MAX_AMP 2.5
dac: MW_IQ_I IQ_MAX_AMP
dac: MW_IQ_Q 0
pulseon: MWTrg 0.4
t += 1

%%%%%%%%%%%%%%  Trap ramp for Rydberg  %%%%%%%%%%%%%%%%%%
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.02 10 %0.15
t += 10
%%%% 420 sample and hold %%%%
t += -10
on: Ryd420Trg
t += 3.0
on: Ryd420Hold
t += 1.0
off: Ryd420Trg
t += 0.1
on: Ryd420ExpShutter
t += 10-3-1-0.1
%%%% 420 sample and hold %%%%
%% 1013 sample and hold %%%%
t += -10
on: Ryd1013Trg
t += 1
dacramp: Ryd1013Amp zero1013SetPoint ryd1013_amplitude 4
t += 6
on: Ryd1013Hold
t += 0.1
off: Ryd1013Trg
t += 10-6-1-0.1
%% 1013 sample and hold %%%%

%%%%%%% ground state pushout with probe beam %%%%%
%t += -10
%on: PrbShutter
%on: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%off: OPShutter
%ol: ol_cooling d2_cooling_prb_resonance-(250) %-(-266.65)
%ol: ol_repump d2_repump_prb_resonance
%dac: PrbRepAmp 10 %10
%dac: PrbAmp {3 prb_pwr}
%off: PrbRepTrg
%off: PrbTrg
%t += 10
%%%%%%% ground state pushout with probe beam %%%%%
%%%%% ground state pushout with OP beam %%%%%
%t += -10
%on: PrbShutter
%on: OPShutter
%%off: PrbShutter
%%off: OPShutter
%
%off: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%off: TARepShutter
%ol: ol_cooling d2_cooling_resonance-(250) %-(-266.65)
%ol: ol_repump d2_repump_prb_resonance+150
%dac: PrbRepAmp 10
%dac: PrbAmp 8
%dac: OPAmp {3 op_pwr_high} %1
%off: PrbRepTrg
%off: PrbTrg
%off: OPTrg
%t += 10
%%%%% ground state pushout with OP beam %%%%%
%%%%%% ground state depump with probe beam %%%%%
%t += -10
%on: PrbShutter
%on: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%off: OPShutter
%ol: ol_cooling d2_cooling_prb_resonance-(250) %-(-266.65)
%ol: ol_repump d2_repump_prb_resonance+150
%dac: PrbRepAmp -1
%dac: PrbAmp {0.5 prb_pwr}
%off: PrbRepTrg
%off: PrbTrg
%t += 10
%%%%%% ground state pushout with probe beam %%%%%


on: ryd420RFSourceSwitch
t += 0.4
on: SLMTweezerHold
t += 0.101
off: SLMTweezerTrg


%t += -250/1000
%ol: ol_repump d2_repump_prb_resonance
%ol: ol_cooling d2_cooling_resonance
%t += 250/1000
%
%%t += time_scan
%
%
%%off: SLMTweezerTrg
%%t += 20/1000-time_scan_us/1000
%on: do8_4
%%on: PrbTrg
%%on: PrbRepTrg
%%on: OPTrg
%t += time_scan_us/1000 %0.9/1000
%%off: OPTrg
%%off: PrbTrg
%%off: PrbRepTrg
%ol: ol_cooling d2_cooling_resonance-(250)
%ol: ol_repump d2_repump_prb_resonance+150
%off: do8_4
%on: SLMTweezerTrg
%
%t += 10/1000

%%%%% Ryd Rabi %%%%%%
t += 0.35/1000
t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%pulseon: Ryd1013Mako 10/1000

t += 0.9/1000
t += -1/1000/2 %-int((1+time_scan_us)*50)/50/1000/2
pulseon: Ryd1013Trg 1/1000+time_scan_us/1000
t += 1/1000/2
t += -0.9/1000

on: do8_4 %dummy trigger for picoscope
on: Ryd420Trg % scan to get Rabi
t += time_scan_us/1000
%t += (0.01+((sign(20.5-x)+1)/2)*0.01*x+((sign(x-20.5)+1)/2)*int(0.4*exp((x-21)*ln(1.076))*100)/100)/1000
off: Ryd420Trg
off: do8_4 
t += 0.95/1000
t += 0.35/1000
%%%%% Ryd Rabi %%%%%%

%%%%% Ryd Ramsey %%%%%%
%var Ryd_pi2_us 0.06
%%var Ryd_pi_us 0.1 %0.20 %0.185
%t += 0.35/1000
%t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi2_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += time_scan_us/1000
%
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi2_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += 0.95/1000
%t += 0.35/1000
%%%%% Ryd Ramsey %%%%%%

%%%%%% Ryd pi wait Rydb pi lifetime %%%%%%
%var Ryd_pi_us 0.10
%var Ryd_lifetime_t_total_us 7.4
%t += Ryd_lifetime_t_total_us/1000
%t += -(Ryd_lifetime_t_total_us/2+Ryd_pi_us+time_scan_us/2)/1000
%
%t += 0.35/1000
%t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%pulseon: Ryd1013Mako 10/1000
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += time_scan_us/1000
%
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += 0.35/1000
%t += 0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%t += (Ryd_lifetime_t_total_us/2-Ryd_pi_us-time_scan_us/2)/1000
%%%%%% Ryd pi wait Rydb pi lifetime %%%%%%
%%%%%% Ryd pi MW Rydb pi %%%%%%
%var Ryd_pi_us 0.06
%var Ryd_lifetime_t_total_us 6.4
%t += 0.35/1000
%t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%
%t += Ryd_lifetime_t_total_us/1000
%t += -(Ryd_lifetime_t_total_us/2+Ryd_pi_us+time_scan_us/2+0.2)/1000
%
%pulseon: Ryd1013Mako 10/1000
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += 1.5/1000
%t += 0.2/1000
%on: do8_4 
%on: MWAmpTrg
%t += time_scan_us/1000
%off: MWAmpTrg
%off: do8_4 
%t += 0.2/1000
%t += -1.5/1000
%
%%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%%off: do8_4 
%
%t += (Ryd_lifetime_t_total_us/2-Ryd_pi_us-time_scan_us/2-0.2)/1000
%
%t += 0.95/1000
%t += 0.35/1000
%
%%%%%% Ryd pi MW Rydb pi %%%%%%


t += 1/1000
on: do8_4 
on: MWAmpTrg
on: SiglentTrg
t += -1/1000

on: SLMTweezerTrg

t += 0.01
off: MWAmpTrg
off: SiglentTrg
off: do8_4 
t += -0.01

%t += -0.1
off: SLMTweezerHold
off: Ryd420Shutter
off: PrbShutter
on: PrbCoolShutter
off: OPShutter
on: TARepShutter
t += 0.1
dacramp: SLMTweezerIntensity slm_twz_intensity*0.02 slm_twz_intensity 10.08 %0.15
t += 10.08
%t += 0.1

t += -9
dacramp: Ryd1013Amp ryd1013_amplitude zero1013SetPoint 9
t += 9

%pulseon: MWAmpTrg 0.1
t += 0.1
off: Ryd1013Trg
off: Ryd1013Hold
off: Ryd1013Shutter
off: Ryd420Hold
t += 0.5

%%%%%%%%%%%%%%  End Rydberg  %%%%%%%%%%%%%%%%%%


t += 10
%call StateSelectivePushout()
%t += 10
%call setZeroField()

%    dac: BiasCoilX pgc_twz_bias_x
%    dac: BiasCoilY pgc_twz_bias_y 
%    dac: BiasCoilZ pgc_twz_bias_z
%t += 100
%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 10+t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 10
call RydbergBeamCameraFootprint()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
call EndSequence()
