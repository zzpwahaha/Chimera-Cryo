%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()
call TOF(10)

%t += -10
%dacramp: SLMTweezerIntensity 1.2 slm_twz_intensity 10
%t += 10

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz % 10
off: UVLampTrg
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz %10 
%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 5

%%%%%%%%%%%%%%%%%% large field LGM optimized at RT %%%%%%%%%%%%%%%%
%t += 10
%call D1InTrapLargeFieldLGMPrb_RT(-7.6)
%%%%%%%%%%%%%%%%% large field LGM optimized at RT  %%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%% large field LGM optimzied at cryo %%%%%%%%%%%%%%%%
t += 10
call D1InTrapLargeFieldLGMPrb_Cryo(-8.877) %-8.95
%%%%%%%%%%%%%%%% large field LGM optimzied at cryo %%%%%%%%%%%%%%%%



%%%%%%%%%%%%%%%% bias field and OP %%%%%%%%%%%%%%%%
t += 5
call setQuantizationField()
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.06 10 %0.02
t += 10
t += t_field_settling-20
dacramp: SLMTweezerIntensity slm_twz_intensity*0.06 slm_twz_intensity 10 %0.02
t += 10
call OpticalPumping22()
%%%%%%%%%%%%%%%% bias field and OP %%%%%%%%%%%%%%%%


%%%%%%%%%%%%%%  Prepare Rydberg beams %%%%%%%%%%%%%%%%%%
var zero1013SetPoint -0.01
%var ryd1013SetPoint 4.0 %4.0 %2.0

on: Ryd1013Shutter
ddsfreq: Ryd420Brimrose ryd420_resonance
t += 5
%on: Ryd420Shutter
off: Ryd420ExpShutter
%on: Ryd1013Shutter
on: ryd420RFSourceSwitch
off: ryd420AWGShapedChSwitch

dac: Ryd420Amp ryd420_amplitude %0.11 %0.11 %0.05 %0.2 %amplitude_scan %0.8 %0.1 %0.55 %0.30 %0.34
dac: Ryd1013Amp zero1013SetPoint %2.0 %0.55 %0.60 %0.68

var IQ_MAX_AMP 2.5
dac: MW_IQ_I IQ_MAX_AMP
dac: MW_IQ_Q 0
pulseon: MWTrg 0.4
%pulseon: Keysight2Trg 0.01
t += 1

%%%%%%%%%%%%%%  Trap ramp for Rydberg  %%%%%%%%%%%%%%%%%%
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.02 10 %0.15
t += 10
%%%% 420 sample and hold %%%%
t += -10
on: Ryd420Trg
t += 3.0
on: Ryd420Hold
t += 1.0
off: Ryd420Trg
t += 0.1
on: Ryd420ExpShutter
t += 10-3-1-0.1
%%%% 420 sample and hold %%%%
%%%% 1013 sample and hold %%%%
t += -10
on: Ryd1013Trg
t += 1
dacramp: Ryd1013Amp zero1013SetPoint ryd1013_amplitude 4
t += 4
t += 1
%on: Ryd1013Hold
t += 0.1
%off: Ryd1013Trg
t += 10-4-1-1-0.1
%%%% 1013 sample and hold %%%%

%%%%%%% ground state pushout with probe beam %%%%%
%t += -10
%on: PrbShutter
%on: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%off: OPShutter
%ol: ol_cooling d2_cooling_prb_resonance-(250) %-(-266.65)
%ol: ol_repump d2_repump_prb_resonance
%dac: PrbRepAmp 10 %10
%dac: PrbAmp {3 prb_pwr}
%off: PrbRepTrg
%off: PrbTrg
%t += 10
%%%%%%% ground state pushout with probe beam %%%%%
%%%% ground state pushout with OP beam %%%%%
t += -10
on: PrbShutter
on: OPShutter
%off: PrbShutter
%off: OPShutter

off: PrbCoolShutter
off: xyzMOTShutter
off: D1LGMShutter
off: D1LGMPrbShutter
off: TARepShutter
ol: ol_cooling d2_cooling_resonance-(250) %-(-266.65)
ol: ol_repump d2_repump_prb_resonance+150
dac: PrbRepAmp 10
dac: PrbAmp 8
dac: OPAmp {3 op_pwr_high} %1
off: PrbRepTrg
off: PrbTrg
off: OPTrg
t += 10
%%%%% ground state pushout with OP beam %%%%%
%%%%%%% ground state depump with probe beam %%%%%
%t += -10
%on: PrbShutter
%on: PrbCoolShutter
%%off: PrbShutter
%%off: PrbCoolShutter
%
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%off: OPShutter
%ol: ol_cooling d2_cooling_prb_resonance-(-50) %-(-266.65)
%ol: ol_repump d2_repump_prb_resonance+150
%dac: PrbRepAmp -1
%dac: PrbAmp {0.25 prb_pwr}
%off: PrbRepTrg
%off: PrbTrg
%t += 10
%%%%%%% ground state depump with probe beam %%%%%

pulseon: Ryd1013Mako 10/1000
on: ryd420RFSourceSwitch
off: ryd420AWGShapedChSwitch
t += 0.4
on: SLMTweezerHold
t += 0.101
off: SLMTweezerTrg

%%t += 0.35/1000
%
%%t += -250/1000
%%ol: ol_repump d2_repump_prb_resonance
%%ol: ol_cooling d2_cooling_resonance
%%t += 250/1000
%%
%%t += time_scan
%
%
%%off: SLMTweezerTrg
%%t += 20/1000-time_scan_us/1000
%on: do8_4
%%on: PrbTrg
%%on: PrbRepTrg
%%on: OPTrg
%t += time_scan_us/1000 %0.9/1000
%%off: OPTrg
%%off: PrbTrg
%%off: PrbRepTrg
%%ol: ol_cooling d2_cooling_resonance-(250)
%%ol: ol_repump d2_repump_prb_resonance+150
%off: do8_4
%
%%t += 0.35/1000
%
%%on: SLMTweezerTrg
%%t += 10/1000

%%%%%%%% Ryd Rabi %%%%%%
%t += 0.35/1000
%t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += time_scan_us/1000
%%t += (0.01+((sign(20.5-x)+1)/2)*0.01*x+((sign(x-20.5)+1)/2)*int(0.4*exp((x-21)*ln(1.076))*100)/100)/1000
%off: Ryd420Trg
%off: do8_4 
%t += 0.95/1000
%t += 0.35/1000
%%%%%%% Ryd Rabi %%%%%%

%%%%% Ryd Ramsey %%%%%%
%var Ryd_pi2_us 0.06
%%var Ryd_pi_us 0.1 %0.20 %0.185
%t += 0.35/1000
%t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi2_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += time_scan_us/1000
%
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi2_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += 0.95/1000
%t += 0.35/1000
%%%%% Ryd Ramsey %%%%%%

%%%%% Ryd pi wait Rydb pi lifetime %%%%%%
var Ryd_pi_us 0.4 %0.42 %0.31
var Ryd_lifetime_t_total_us 40
t += Ryd_lifetime_t_total_us/1000
%t += -(Ryd_lifetime_t_total_us/2+Ryd_pi_us+time_scan_us/2)/1000 % center align
t += -(2*Ryd_pi_us+time_scan_us)/1000 % right align

t += 0.35/1000
t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator

on: do8_4 %dummy trigger for picoscope
on: Ryd420Trg % scan to get Rabi
t += Ryd_pi_us/1000
off: Ryd420Trg
off: do8_4 

t += time_scan_us/1000

% Pushout, 4.5us (quench) or 2us (ramp) pushout time
t += -(2.24+0.5+0.5)/1000 %3us pushout, 0.5us is buffer time
%t += -(3.78+0.25)/1000 %4.5us pushout, 0.25 is for center it with 5us wait time
t += -250/1000
ol: ol_repump d2_repump_prb_resonance
ol: ol_cooling d2_cooling_resonance
t += 250/1000
on: PrbTrg
on: PrbRepTrg
on: OPTrg
t += 3/1000 %4.5/1000 %2/1000 for non-quenching
off: OPTrg
off: PrbTrg
off: PrbRepTrg
%ol: ol_cooling d2_cooling_resonance-(250)
%ol: ol_repump d2_repump_prb_resonance+150
t += -3/1000 %-4.5/1000 %2/1000 for non-quenching
%t += (3.78+0.25)/1000
t += (2.24+0.5+0.5)/1000 %3us pushout, 0.5us is buffer time
% Pushout, 4.5us (quench) or 2us (ramp) pushout time

%% depump, 4us before second Ryd pi pulse, 2us pushout time
%t += -(1.21+0.5)/1000 %2us depump, 0.5us is buffer time
%t += -250/1000
%ol: ol_cooling d2_cooling_prb_resonance-(-266.65)
%ol: ol_repump d2_repump_prb_resonance+150
%t += 250/1000
%on: PrbTrg
%t += 2/1000 %0.9/1000
%off: PrbTrg
%%ol: ol_cooling d2_cooling_prb_resonance-(-50)
%%ol: ol_repump d2_repump_prb_resonance+150
%t += -2/1000
%t += (1.21+0.5)/1000 %(2+0.33+0.6-1)/1000
%% depump, 4us before second Ryd pi pulse, 2us pushout time

on: do8_4 %dummy trigger for picoscope
on: Ryd420Trg % scan to get Rabi
t += Ryd_pi_us/1000 
off: Ryd420Trg
off: do8_4 

%% Pushout, 4us before second Ryd pi pulse, 2us pushout time
%t += (-2.24+3+0.5)/1000
%%t += (-3.78+4.5)/1000 %0.4 is pi time used in measurement
%on: PrbTrg
%on: PrbRepTrg
%on: OPTrg
%t += 3/1000  %4.5/1000 %2/1000
%off: OPTrg
%off: PrbTrg
%off: PrbRepTrg
%%ol: ol_cooling d2_cooling_resonance-(250)
%%ol: ol_repump d2_repump_prb_resonance+150
%t += -3/1000
%%t += -(-3.78+4.5)/1000
%t += -(-2.24+3+0.5)/1000
%% Pushout, 4us before second Ryd pi pulse, 2us pushout time

t += 30/1000
% for pushout
ol: ol_cooling d2_cooling_resonance-(250)
ol: ol_repump d2_repump_prb_resonance+150
% for depump
%ol: ol_cooling d2_cooling_prb_resonance-(-50)
%ol: ol_repump d2_repump_prb_resonance+150
t += -30/1000

t += 0.35/1000
t += 0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%t += (Ryd_lifetime_t_total_us/2-Ryd_pi_us-time_scan_us/2)/1000 % center align
%t += 3.5/1000
%%%%%% Ryd pi wait Rydb pi lifetime %%%%%%

%%%%%% Ryd pi MW Rydb pi %%%%%%
%var Ryd_pi_us 0.06
%var Ryd_lifetime_t_total_us 6.4
%t += 0.35/1000
%t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%
%t += Ryd_lifetime_t_total_us/1000
%t += -(Ryd_lifetime_t_total_us/2+Ryd_pi_us+time_scan_us/2+0.2)/1000
%
%pulseon: Ryd1013Mako 10/1000
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += 1.5/1000
%t += 0.2/1000
%on: do8_4 
%on: MWAmpTrg
%t += time_scan_us/1000
%off: MWAmpTrg
%off: do8_4 
%t += 0.2/1000
%t += -1.5/1000
%
%%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%%off: do8_4 
%
%t += (Ryd_lifetime_t_total_us/2-Ryd_pi_us-time_scan_us/2-0.2)/1000
%
%t += 0.95/1000
%t += 0.35/1000
%
%%%%%% Ryd pi MW Rydb pi %%%%%%

%repeat: int(integer_scan)
t += 1/1000
on: do8_4 
on: MWAmpTrg
%on: SiglentTrg
t += -1/1000
%end

on: SLMTweezerTrg

t += 0.01
off: MWAmpTrg
off: SiglentTrg
off: do8_4 
t += -0.01

%pulseon: Keysight2Trg 0.01
off: SLMTweezerHold
off: Ryd420Shutter
off: PrbShutter
on: PrbCoolShutter
off: OPShutter
on: TARepShutter
t += 0.1
dacramp: SLMTweezerIntensity slm_twz_intensity*0.02 slm_twz_intensity 10.08 %10.08 %0.15
t += 10.08

t += -10.08
t += 2
%off: SLMTweezerHold
t += 1
%pulseon: Keysight2Trg 0.01
t += 1
t += 10.08-(2+1+1)

t += -9
dacramp: Ryd1013Amp ryd1013_amplitude zero1013SetPoint 9
t += 9

%pulseon: MWAmpTrg 0.1
t += 0.1
off: Ryd1013Trg
off: Ryd1013Hold
off: Ryd1013Shutter
off: Ryd420Hold
t += 0.5

%%%%%%%%%%%%%%  End Rydberg  %%%%%%%%%%%%%%%%%%


t += 10
%call StateSelectivePushout(3.5)
%t += 10
%call setZeroField()
repeat: is_cryo %int(t_field_settling/400)
    dac: BiasCoilX pgc_twz_bias_x
    dac: BiasCoilY pgc_twz_bias_y 
    dac: BiasCoilZ pgc_twz_bias_z
t += 100
end
%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 10+t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 10
%call RydbergBeamCameraFootprint()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
call EndSequence()
