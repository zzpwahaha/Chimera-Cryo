%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
call CryoMOTLoadingPGC()
%call CryoMOTEnhancedLoadingLGM()


%%%%%%%%%%%%%%%  TOF  %%%%%%%%%%%%%%%%%%
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 15

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser fre q parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 15

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
t += 15 

call setQuantizationField()
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
t += 10
t += t_field_settling-20
dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
t += 10

%%%%%%%%%%%%%% optical pumping into |2,2> state with 2-2'' OP, 1-2'' probe %%%%%%%%%%%
call OpticalPumping22()
t += 1

t += 5

%%%%%%%%%%%%%% Ramsey with D1 %%%%%%%%%%%%%%
var measure_trap_depth_at 0.6
dacramp: SLMTweezerIntensity slm_twz_intensity measure_trap_depth_at 10
t += 10

%%%% D1 state transfer sample and hold %%%%
t += -15
dac: D1StateTransferAmp -1.0
off: D1StateTransferShutter 
t += 4
on: D1StateTransferTrg
t += 4
on: D1StateTransferHold
t += 0.1
off: D1StateTransferTrg
on: D1StateTransferShutter 
t += 15-(4+4+0.1)
%%%% D1 state transfer sample and hold %%%%


pulseon: mako1 0.1
t += 1
%pulseon: do8_4 0.1 %dummy trigger for picoscope
%on: D1StateTransferTrg
%t += time_scan_us/1000
%off: D1StateTransferTrg


var pi2_us 8.75
var pi_us 17.5
var ramsey_time_us 10000
var ramsey_time 10
var RamseyFringeTrapFraction 0.1

t += 0.1
pulseon: D1StateTransferTrg pi2_us/1000
t += pi2_us/1000

t += ramsey_time_us/2/1000
t += -(ramsey_time_us/2/1000/2+1+time_scan/2)
dacramp: SLMTweezerIntensity measure_trap_depth_at measure_trap_depth_at*RamseyFringeTrapFraction 1
t += 1
t += time_scan
dacramp: SLMTweezerIntensity measure_trap_depth_at*RamseyFringeTrapFraction measure_trap_depth_at 1
t += 1
t += ramsey_time_us/2/1000/2-(1+time_scan/2)

pulseon: do8_4 0.001 
pulseon: D1StateTransferTrg pi_us/1000
t += pi_us/1000
t += ramsey_time_us/2/1000

pulseon: D1StateTransferTrg pi2_us/1000
t += pi2_us/1000


t += 1
off: D1StateTransferHold
off: D1StateTransferShutter 

dacramp: SLMTweezerIntensity measure_trap_depth_at slm_twz_intensity 10
t += 10

call StateSelectivePushout(3.5)

%dac: BiasCoilX pgc_twz_bias_x
%dac: BiasCoilY pgc_twz_bias_y 
%dac: BiasCoilZ pgc_twz_bias_z
%t += 100+15


%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 200
%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval
call PGCTweezerImaging()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
pulseon: DO1_0 0.5
