%rearrange mode scrunchspacing amprate moverate 
% AmpIncr=1, Ramp from 0 to 100: 2**16*2**10/153.6MHz = 0.4369sec
% Frequency increment = 1  => 0.897 um/ms

%rearrange 1 scrunchxtarget 1 2000 135 %160 %24 %moverate 
rearrange 1 removefilterscrunchxtarget 1 2000 22 %28 %27 %20 %27 %135 
%rearrange 1 filterscrunchxtarget 1 2000 135 %24 %160 %24 %moverate 
%rearrange 1 tweezer1dinittest 1 2000 24 
singlex_repeatx 5
singlex_repeaty 3
singley_repeatx 1
singley_repeaty 6 %7

xoffset aod_offset_x %+frequency_scan %aod_dac0_freq
yoffset aod_offset_y %+frequency_scan %aod_dac1_freq


%loadx   11111111111111111111 %1W
%loady   11111 %1.6W

loadx   11111111111111111111 % 1W
loady   10000 %1.26W

%loadx   10000000000000000000 %1.28W
%loady   11111 %1.6W

%loadx   10000000000000000000 %1.28W
%loady   10000 %1.26W

initx   11111111111111111111 
inity   11111

%filterx 11111111111111111111 %10
%filterx 10010010010010010010 %10
%filtery 00100

%filterx 11100000000000000111
filterx 11111100000000000000
filtery 11111

paintx 00000000010000000000
painty 00100

targetstart 

%10101010101010101010
%00000000000000000000
%10101010101010101010
%00000000000000000000
%10101010101010101010

%10101010101010101010
%01010101010101010101
%10101010101010101010
%01010101010101010101
%10101010101010101010

%00011111111111111000
%00011111111111111000
%00011111111111111000
%00011111111111111000
%00011111111111111000

00000011111111111111
00000011111111111111
00000011111111111111
00000011111111111111
00000011111111111111

targetend 

