% set DAC, channel, amp, freq, phase
% setmove stepID, DAC, channel, fjump, pjump, amp, astep, freq, fstep, phase
%set DAC1 0 74 94.6021 180
%set DAC1 8 74 94.6021 180
%set DAC1 16 74 94.6021 180
%set DAC1 24 74 94.6021 180
%set DAC1 32 74 94.6021 180
%set DAC1 40 74 94.6021 180
%set DAC1 1 74 94.6021 180

var ch0 0
var ch1 8
var ch2 2
var ch3 10
var ch4 4
var ch5 5
var ch6 6


set DAC1 ch0 74 94.6021 0
set DAC1 ch1 74 94.6021 0
set DAC1 ch2 74 94.6021 0
set DAC1 ch3 74 94.6021 0
set DAC1 ch4 74 94.6021 0
set DAC1 ch5 74 94.6021 0
set DAC1 ch6 74 94.6021 0


% //step 0: turn off all load tones.
% setmove stepID, DAC, channel, fjump, pjump, amp, astep, freq, fstep, phase
setmove 0 DAC1 0 1 1 0.01 -2000 0 0 0
setmove 0 DAC1 8 1 1 0.01 -2000 0 0 0
