% setmove stepID, DAC, channel, fjump, pjump, amp, astep, freq, fstep, phase
% //step 1: ramp up tones at initial locations and phases
setmove 1 DAC1 ch0 1 1 74 2000 94.6021 0 0
setmove 1 DAC1 ch1 1 1 74 2000 94.6021 0 0
setmove 1 DAC1 ch2 1 1 74 2000 94.6021 0 0
setmove 1 DAC1 ch3 1 1 74 2000 94.6021 0 0
setmove 1 DAC1 ch4 1 1 74 2000 94.6021 0 0
setmove 1 DAC1 ch5 1 1 74 2000 94.6021 0 0
setmove 1 DAC1 ch6 1 1 74 2000 94.6021 0 0

% //step 2: ramp to new locations
setmove 2 DAC1 ch0 0 0 74 2000 94.6021 24 0
setmove 2 DAC1 ch1 0 0 74 2000 94.6021 24 0
setmove 2 DAC1 ch2 0 0 74 2000 94.6021 24 0
setmove 2 DAC1 ch3 0 0 74 2000 94.6021 24 0
setmove 2 DAC1 ch4 0 0 74 2000 94.6021 24 0
setmove 2 DAC1 ch5 0 0 74 2000 94.6021 24 0
setmove 2 DAC1 ch6 0 0 74 2000 94.6021 24 0

% //step 3: ramp all tones to 0
setmove 3 DAC1 ch0 1 0 0.01 -2000 94.6021 0 0
setmove 3 DAC1 ch1 1 0 0.01 -2000 94.6021 0 0
setmove 3 DAC1 ch2 1 0 0.01 -2000 94.6021 0 0
setmove 3 DAC1 ch3 1 0 0.01 -2000 94.6021 0 0
setmove 3 DAC1 ch4 1 0 0.01 -2000 94.6021 0 0
setmove 3 DAC1 ch5 1 0 0.01 -2000 94.6021 0 0
setmove 3 DAC1 ch6 1 0 0.01 -2000 94.6021 0 0

% //additional snapshot ramping down all channels - unclear why needed, but prevents extra trigger issues.
