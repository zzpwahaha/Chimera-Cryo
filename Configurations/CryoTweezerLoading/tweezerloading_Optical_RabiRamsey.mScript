%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
t += 15 %+500


call setQuantizationField()
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.15 10
t += 10
t += t_field_settling-20 %100
dacramp: SLMTweezerIntensity slm_twz_intensity*0.15 slm_twz_intensity 10
t += 10


%%%%%%%%%%%%%% optical pumping into |2,2> state with 2-2'' OP, 1-2'' probe %%%%%%%%%%%
call OpticalPumping22()
%	on: PrbShutter
%	off: PrbCoolShutter
%	off: xyzMOTShutter
%	off: D1LGMShutter
%	off: D1LGMPrbShutter
%	on: OPShutter
%	off: TARepShutter
%	ol: ol_cooling d2_cooling_resonance-(29-266.65)  %29
%	ol: ol_repump d2_repump_prb_resonance+(29) %29
%	dac: PrbRepAmp 8
%	dac: PrbAmp 8
%	dac: OPAmp {0.1 op_pwr}
%	t += t_shutter
%	on: OPTrg
%	on: PrbRepTrg
%	on: PrbTrg
%	t += 0.20 %time_scan %0.20 %0.06 %0.04
%	off: OPTrg
%	t += 0.005
%	off: PrbTrg
%	off: PrbRepTrg
%	off: OPShutter
%	off: PrbShutter


t += 1

%t += 10
%%%%%%%% depump out of F=2, other than |2,2> if with circular polarization, using cooling 2-2'', using OP beam %%%%%%%%%%%
%off: PrbShutter
%on: OPShutter
%off: TARepShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%ol: ol_cooling d2_cooling_resonance-(3.22+30-266.65) % 30 MHz light shift and 3.22 differential zeeman for 22 to 22 %resonance_scan
%ol: ol_repump d2_repump_resonance+(28.8+266.65+30) %
%%dac: OPAmp {0.1 op_pwr} 
%%dac: OPAmp {0.03 op_pwr} 
%dac: OPAmp {0.03 op_pwr} 
%t += 10
%on: OPTrg
%t += time_scan %0.005 %0.08 %0.04 %0.005 %time_scan %0.001
%off: OPTrg
%off: OPShutter

%t += 10
%%%%%%%% depumping from repump during OP
%	on: PrbShutter
%	off: PrbCoolShutter
%	off: xyzMOTShutter
%	off: D1LGMShutter
%	off: D1LGMPrbShutter
%	off: OPShutter
%	off: TARepShutter
%	ol: ol_cooling d2_cooling_resonance-(29-266.65)  %29
%	ol: ol_repump d2_repump_prb_resonance+(29) %29
%	dac: PrbRepAmp 8
%	dac: PrbAmp 8
%	dac: OPAmp {0.1 op_pwr}
%	t += t_shutter
%	on: OPTrg
%	on: PrbRepTrg
%	on: PrbTrg
%	t += time_scan %0.06
%	off: OPTrg
%%	t += 0.005
%	off: PrbTrg
%	off: PrbRepTrg
%	off: OPShutter
%	off: PrbShutter
%	on: TARepShutter



%pulseon: QubitMWTrg 0.4
t += 5
%%%%%%%%%%%%%%% MW %%%%%%%%%%%
var mw_rabi_pi2 0.0447 %0.041 %0.041 %0.01 %0.0599 %0.0296
var IQ_MAX_AMP 2.5
dac: MW_IQ_I IQ_MAX_AMP
dac: MW_IQ_Q 0
pulseon: MWTrg 0.4
t += 1

% Winfreak always on
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
t += 10
%%%%%%%% D1 sample and hold %%%%%%%% 
%t += -15
%dac: D1StateTransferAmp -1 %-5 %-1.6 %-2.5
%off: D1StateTransferShutter 
%t += 4
%on: D1StateTransferTrg
%pulseon: mako1 0.1
%t += 4
%on: D1StateTransferHold
%t += 0.1
%off: D1StateTransferTrg
%on: D1StateTransferShutter 
%t += 15-(4+4+0.1)
%%%%%%%% D1 sample and hold %%%%%%%% 

%%%%%%%%%%%%%%%% Turn off microwave, blast with D1
%off: qubitmwtrg
%
%on: D1StateTransferTrg
%
%t += time_scan
%
%off: D1StateTransferTrg
%
%on: qubitmwtrg
%%%%%%%%%%%%%%%
var D1_Rabi_pi_us 16.67
var MW_Rabi_2111_pi_us 20
%pulseon: mako1 0.1
t += 1

pulseon: do8_4 0.1 %dummy trigger for picoscope
%%%%%%%%%% D1 %%%%%%%%%% 
%on: D1StateTransferTrg
%t += time_scan_us/1000
%off: D1StateTransferTrg
%%%%%%%%%% D1 %%%%%%%%%% 


%%%%%%%%%% MW after D1 %%%%%%%%%% 
%on: D1StateTransferTrg
%t += D1_Rabi_pi_us/1000
%off: D1StateTransferTrg

t += 0.010
pulseon: MWAmpTrg MW_Rabi_2111_pi_us/1000 %MW_Rabi_2111_pi  %time_scan
t += MW_Rabi_2111_pi_us/1000 %MW_Rabi_2111_pi %time_scan
%%%%%%%%%% MW after D1 %%%%%%%%%% 


%var pi2_us 4.55
%var pi_us 9.11
%pulseon: D1StateTransferTrg pi2_us/1000
%t += pi2_us/1000
%t += time_scan_us/2/1000
%
%t += time_scan_us/2/1000
%pulseon: D1StateTransferTrg pi2_us/1000
%t += pi2_us/1000

t += 1
off: D1StateTransferHold
off: D1StateTransferShutter 
dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
t += 10


t += 10
call StateSelectivePushout()
t += 5

%call TrapLowerAndRise(twz_intensity, twz_intensity*0.1, 10, 15)
%t += 15
%dac: BiasCoilX pgc_twz_bias_x
%dac: BiasCoilY pgc_twz_bias_y 
%dac: BiasCoilZ pgc_twz_bias_z
%t += 100


%call ReleaseRecaptureSLM(t_twz_release)
%pulseon: do8_4 0.1 %dummy trigger for picoscope
%t += 10

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval
call PGCTweezerImaging()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10

%call RydbergBeamCameraFootprint()
%on: D1StateTransferShutter 
%dac: D1StateTransferAmp -2
%t += 5
%on: D1StateTransferTrg
%t += 4
%pulseon: mako1 0.1
%t += 2
%off: D1StateTransferTrg
%t += 10
pulseon: DO1_0 0.5
