%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()

%%%%%%%%%%%%%%%  TOF  %%%%%%%%%%%%%%%%%%
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
t += 15 %+500

%t += 500
%t += 10
%off: PrbShutter
%off: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%off: OPShutter
%off: TARepShutter
%t += 10

%%%%%%%%%%%%%%%%% large field LGM optimized at RT %%%%%%%%%%%%%%%%
t += 10
    off: xyzMOTShutter
    on: D1LGMPrbShutter
    off: D1LGMShutter
    on: D1LGMEOMTrg
    dac: D1LGMEOMAmp 0 %amplitude_scan %d1lgmprb_twz_rep_amp
    dac: D1LGMAmp {4.5 d1lgm_prb_pwr} % amplitude_scan%d1lgmprb_twz_cool_amp
    ol: ol_D1LGM D1_LGMCooling_resonance-230 %resonance_scan %d1lgm_twz_olcool
    ol: ol_D1_repump Rb87_HFSplitting+(-7.6) %4.5 %resonance_scan %d1lgm_twz_olrepump

    dac: BiasCoilX pgc_twz_bias_x %-1.75 %pgc_twz_bias_x
    dac: BiasCoilY -4.5 %pgc_twz_bias_y %-5 %pgc_twz_bias_y=-4.5
    dac: BiasCoilZ pgc_twz_bias_z %pgc_twz_bias_z
    t += t_shutter

    on: D1LGMTrg
    t += 25 %time_scan %t_lgm_cool_time 
    pulseon: DO1_0 1
    off: D1LGMTrg
    off: D1LGMEOMTrg
    off: D1LGMShutter
    off: D1LGMPrbShutter

t += 1
    dac: BiasCoilX pgc_twz_bias_x 
    dac: BiasCoilY pgc_twz_bias_y
    dac: BiasCoilZ pgc_twz_bias_z
%%%%%%%%%%%%%%%%% large field LGM optimized at RT  %%%%%%%%%%%%%%%%



t += 10
off: ryd420trg
%dac: BiasCoilX quantization_bias_x
%dac: BiasCoilY -1.065+0.05 %-2.33 %quantization_bias_y %-0.95 
%dac: BiasCoilZ -0.05-0.039 %-0.04 


%%%%% cold bias field %%%%% 
%dac: BiasCoilX -2.5+0.75 %-2.5
%dac: BiasCoilY -0.824+(-2.33/2)*switch_toggle
%dac: BiasCoilZ -0.0510 %amplitude_scan 


%%%%% warm bias field %%%%% 
dac: BiasCoilX -2.5+0.75 %quantization_bias_x
dac: BiasCoilY -0.835 %+(-2.23/2)*switch_toggle %-0.834
dac: BiasCoilZ -0.0464 %+amplitude_scan %-0.0473 
% -2.23V for 7G bias field, -2.23V/2 for 3.5 G bias field 


t += t_field_settling %t_field_settling %100 %750


%%%%%%%%%%%%%% optical pumping into |2,2> state with 2-2'' OP, 1-2'' probe %%%%%%%%%%%
%call OpticalPumping22()
on: PrbShutter
off: PrbCoolShutter
off: xyzMOTShutter
off: D1LGMShutter
off: D1LGMPrbShutter
on: OPShutter
off: TARepShutter
%additional 420 commands
%on: ryd420expshutter
%end of 420 commands
ol: ol_cooling d2_cooling_resonance-(29-266.65)  %29
ol: ol_repump d2_repump_prb_resonance+(29) %29
dac: PrbRepAmp 8
dac: PrbAmp 8
dac: OPAmp {0.1 op_pwr} %time_scan
t += t_shutter
on: OPTrg
on: PrbRepTrg
on: PrbTrg
t += 0.2 %0.01
off: OPTrg
t += 0.005
off: PrbTrg
off: PrbRepTrg
off: OPShutter
off: PrbShutter
%%%%%%%%%%%%%% optical pumping into |2,2> state with 2-2'' OP, 1-2'' probe %%%%%%%%%%%

t += 10
%%%%%%%%%%%%%%%%%% D1 %%%%%%%%%%%%%%%%%% 
off: Ryd420Shutter
off: Ryd420ExpShutter
dac: Ryd1013Amp 0.0 
off: Ryd1013Trg

dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
t += 10

%%%% D1 state transfer sample and hold %%%%
t += -15
dac: D1StateTransferAmp -1.0
off: D1StateTransferShutter 
t += 4
on: D1StateTransferTrg
t += 4
on: D1StateTransferHold
t += 0.1
off: D1StateTransferTrg
on: D1StateTransferShutter 
t += 15-(4+4+0.1)
%%%% D1 state transfer sample and hold %%%%

t += 0.5
pulseon: do8_4 0.1 %dummy trigger for picoscope


%%%%%% Rabi/Resonance sequence with D1
on: D1StateTransferTrg
t += time_scan_us/1000
off: D1StateTransferTrg
%%%%%% Rabi/Resonance sequence with D1



t += 0.1
off: D1StateTransferHold
off: D1StateTransferShutter 
t += 0.5

% Ramp tweezer strength back up
dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
t += 10
%%%%%%%%%%%%%%%%%% D1 %%%%%%%%%%%%%%%%%% 


t += 10
call StateSelectivePushout(3.5)
t += 5 

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 15
%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval
call PGCTweezerImaging()

t += 200
call PGCTweezerImaging()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
pulseon: DO1_0 0.5
