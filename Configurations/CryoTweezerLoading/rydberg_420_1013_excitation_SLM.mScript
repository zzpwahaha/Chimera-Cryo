%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
off: UVLampTrg
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 5

call setQuantizationField()
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
t += 10
t += t_field_settling-20
dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
t += 10

call OpticalPumping22()

on: Ryd1013Shutter
ddsfreq: Ryd420Brimrose resonance_scan
t += 15
%on: Ryd420Shutter
off: Ryd420ExpShutter
%on: Ryd1013Shutter
off: Ryd420AWGchswitch
dac: Ryd420Amp 0.2 %0.55 %0.30 %0.34
dac: Ryd1013Amp 4.0 %0.55 %0.60 %0.68

var IQ_MAX_AMP 2.5
dac: MW_IQ_I IQ_MAX_AMP
dac: MW_IQ_Q 0
pulseon: MWTrg 0.4
t += 1

dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
t += 10
%%%% 420 sample and hold %%%%
t += -10
on: Ryd420Trg
t += 1.0
on: Ryd420Hold
t += 1.0
off: Ryd420Trg
t += 0.1
on: Ryd420ExpShutter
t += 10-1-1-0.1
%%%% 420 sample and hold %%%%
%%%% 1013 sample and hold %%%%
t += -6
on: Ryd1013Trg
t += 1
%on: Ryd1013Hold
t += 0.1
%off: Ryd1013Trg
t += 6-1-0.1
%%%% 1013 sample and hold %%%%

var Ryd_pi2_us 0.08
var Ryd_pi_us 0.15 %0.20 %0.185

t += 0.5

t += 0.001
off: SLMTweezerTrg

%%%%% Rabi %%%%%%
t += 0.2/1000
t += -1.0/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
on: do8_4 %dummy trigger for picoscope
on: Ryd420Trg % scan to get Rabi
t += time_scan_us/1000 %time_scan_us/1000
off: Ryd420Trg
off: do8_4 

t += 0.4/1000
on: MWAmpTrg
t += -0.4/1000

t += 1.0/1000
t += 0.2/1000
on: SLMTweezerTrg

t += 0.1
off: MWAmpTrg
t += -0.1

t += -0.08
dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 0.08
t += 0.08
t += 0.08

%pulseon: MWAmpTrg 0.1
t += 0.1
off: Ryd1013Trg
off: Ryd1013Hold
off: Ryd420Shutter
off: Ryd1013Shutter
t += 0.5


t += 15
%call StateSelectivePushout()
%call setZeroField()
    dac: BiasCoilX pgc_twz_bias_x
    dac: BiasCoilY pgc_twz_bias_y 
    dac: BiasCoilZ pgc_twz_bias_z
t += 100
%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 10
call RydbergBeamCameraFootprint()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
pulseon: DO1_0 0.5
