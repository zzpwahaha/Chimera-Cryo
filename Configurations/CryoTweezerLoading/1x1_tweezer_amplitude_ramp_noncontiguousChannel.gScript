setmove 0 DAC1 5 1 1  00.01 -amprate  0.00 0 0.00
setmove 0 DAC1 17 1 1  00.01 -amprate  0.00 0 0.00

% ramp to amplitude
% setmove stepID, DAC, channel, fjump, pjump, amp, astep, freq, fstep, phase
setmove 1 DAC1 0 1 1  69.88 amprate  94.50 0 18.00
setmove 1 DAC1 8 1 1  69.88 amprate  94.50 0 18.00
setmove 1 DAC1 16 1 1  69.88 amprate  94.50 0 18.00
