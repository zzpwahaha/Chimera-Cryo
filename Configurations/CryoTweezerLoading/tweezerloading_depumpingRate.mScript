%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
t += 15 %+500
% 1206+20-(-65) = 1291

call setQuantizationField()
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
t += 10
t += 100-20 %100
dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
t += 10

%%%%%%%%%%%%%% optical pumping into |2,2> state with 2-2'' OP, 1-2'' probe %%%%%%%%%%%
%call OpticalPumping22()
	on: PrbShutter
	off: PrbCoolShutter
	off: xyzMOTShutter
	off: D1LGMShutter
	off: D1LGMPrbShutter
	on: OPShutter
	off: OPShutter
	off: TARepShutter
	ol: ol_cooling d2_cooling_resonance-(29-266.65)  %29
	ol: ol_repump d2_repump_prb_resonance+(29) %29
pulseon: DO8_3 1
	dac: PrbRepAmp 8
	dac: PrbAmp 8
	dac: OPAmp {0.1 op_pwr}
	t += t_shutter
	on: OPTrg
	on: PrbRepTrg
	on: PrbTrg

%	% Hacking
%	t += 0.06+0.1
%	off: PrbTrg 
%	off: PrbRepTrg
%	off: PrbShutter
%	t += -(0.06+0.1)

	t += 0.2 %0.06+0.34266.65
	off: OPTrg
	t += 0.005
	off: PrbTrg 
	off: PrbRepTrg
	off: OPShutter
	off: PrbShutter
	on: TARepShutter

t += 1

%call PrepareF2Manifold()
%    on: PrbShutter
%    off: PrbCoolShutter
%    off: xyzMOTShutter
%    off: D1LGMShutter
%    off: D1LGMPrbShutter
%    off: OPShutter
%    off: PrbRepTrg
%%pulseon: DO8_3 1
%    ol: ol_cooling d2_cooling_prb_resonance-(28.8+266.65)  % detuned on purpose = 930, 1226-200 = 1026
%    ol: ol_repump d2_repump_prb_resonance+30 %(25) %resonance_scan
%    dac: PrbRepAmp 5 %1 %3.0
%    dac: PrbAmp 5 %5.0
%    t += t_shutter
%
%    on: PrbTrg
%    on: PrbRepTrg
%    t += 0.05 
%    off: PrbRepTrg
%    off: PrbTrg
%    off: PrbShutter


%t += 10
%	dac: PrbAmp amplitude_scan
%	dac: OPAmp amplitude_scan
%	dac: PrbRepAmp amplitude_scan
%	dac: DipolePushAmp amplitude_scan
%	dac: scimotamp amplitude_scan
%	dac: srcmotamp amplitude_scan
%	dac: d1lgmamp amplitude_scan
%	dac: d1statetransferamp amplitude_scan
%	dac: tarepamp amplitude_scan
%	dac: d1lgmeomamp amplitude_scan

%pulseon: DO8_3 1
on: DipolePushShutter
%off: DipolePushShutter
    ol: ol_cooling d2_cooling_resonance-(-155) %(resonance_scan) %(29-266.65)
%%1206-(-155) = 1361
%t += -10
%t += 38
t += 10

t += time_scan
off: DipolePushShutter

%call StateSelectivePushout(3.5)
    var FullTrapLightShift 30 % MHz
    var Bfield 7 %G
    var DifferentialZeemanCoef 1.4 % MHz/G
    var PushoutTrapFraction 0.1
    var PushoutTime 0.01 %ms
pulseon: DO8_3 1
    ol: ol_cooling d2_cooling_resonance-(FullTrapLightShift*PushoutTrapFraction+DifferentialZeemanCoef*Bfield) %(7.3) 
    ol: ol_repump d2_repump_resonance+100 % intensional detuned

	dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*PushoutTrapFraction 10
%	on: PrbShutter
%	off: PrbCoolShutter

    off: TARepShutter
    off: PrbShutter
    off: xyzMOTShutter
    off: D1LGMShutter
    off: D1LGMPrbShutter
    on: OPShutter
%pulseon: DO8_3 1

%    dac: PrbRepAmp 7 %1 %3.0
%    dac: PrbAmp 7 %5.0

    dac: OPAmp {0.1 op_pwr} %0.1
    t += 10 %t_shutter

    t += 0.05 % wait for trap depth to settle
    on: OPTrg
%on: PrbTrg
%on: PrbRepTrg
    t += PushoutTime %time_scan %0.05
off: PrbTrg
off: PrbRepTrg
    off: OPTrg
    off: OPShutter
    t += 0.05-PushoutTime
    on: TARepShutter 
    dacramp: SLMTweezerIntensity slm_twz_intensity*PushoutTrapFraction slm_twz_intensity 10 
    t += 10



%call TrapLowerAndRise(twz_intensity, twz_intensity*0.1, 10, 15)
%t += 15
%dac: BiasCoilX pgc_twz_bias_x
%dac: BiasCoilY pgc_twz_bias_y 
%dac: BiasCoilZ pgc_twz_bias_z
%t += 100


%call ReleaseRecaptureSLM(t_twz_release)
%pulseon: do8_4 0.1 %dummy trigger for picoscope
%t += 10

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
%pulseon: DO8_3 1
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval
%pulseon: DO8_3 1
call PGCTweezerImaging()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10

%call RydbergBeamCameraFootprint()
%on: D1StateTransferShutter 
%dac: D1StateTransferAmp -2
%t += 5
%on: D1StateTransferTrg
%t += 4
%pulseon: mako1 0.1
%t += 2
%off: D1StateTransferTrg
%t += 10
pulseon: DO1_0 0.5
