%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
call CryoMOTLoadingPGC()
%call CryoMOTEnhancedLoadingLGM()
call TOF(10)

%t += -10
%dacramp: SLMTweezerIntensity 1.2 slm_twz_intensity 10
%t += 10

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 10 %100-t_pgc_twz
off: UVLampTrg
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 10 %100-t_pgc_twz
%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 5

%%%%%%%%%%%%%%%% large field LGM %%%%%%%%%%%%%%%%
t += 10
    off: xyzMOTShutter
    on: D1LGMPrbShutter
    off: D1LGMShutter
    on: D1LGMEOMTrg
    dac: D1LGMEOMAmp 0 %amplitude_scan %d1lgmprb_twz_rep_amp
    dac: D1LGMAmp {3 d1lgm_prb_pwr} % amplitude_scan%d1lgmprb_twz_cool_amp
    ol: ol_D1LGM D1_LGMCooling_resonance-150 %resonance_scan %d1lgm_twz_olcool
    ol: ol_D1_repump Rb87_HFSplitting+4.5 %resonance_scan %d1lgm_twz_olrepump

    dac: BiasCoilX pgc_twz_bias_x
    dac: BiasCoilY -5 %pgc_twz_bias_y=-4.5
    dac: BiasCoilZ pgc_twz_bias_z %pgc_twz_bias_z
    t += t_shutter

    on: D1LGMTrg
    t += 25 %time_scan %t_lgm_cool_time 
    pulseon: DO1_0 1
    off: D1LGMTrg
    off: D1LGMEOMTrg
    off: D1LGMShutter
    off: D1LGMPrbShutter
%%%%%%%%%%%%%%%% large field LGM %%%%%%%%%%%%%%%%

call setQuantizationField()
%call setZeroField()

dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.02 10
t += 10
t += t_field_settling-20
dacramp: SLMTweezerIntensity slm_twz_intensity*0.02 slm_twz_intensity 10
t += 10

call OpticalPumping22()
%call prepareF1Manifold()

%t += 10
%call setQuantizationField()
%dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.02 10
%t += 10
%t += t_field_settling-20
%dacramp: SLMTweezerIntensity slm_twz_intensity*0.02 slm_twz_intensity 10
%t += 10

%%change field to original OP befor angle
%t += 5
%    dac: BiasCoilX -2.5+0.75-2.5 
%    dac: BiasCoilY -0.839
%    dac: BiasCoilZ -0.048
%% warm
%dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
%t += 10
%t += 50-20
%dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
%t += 10


%%%%%%%%%%%%%%  Prepare Rydberg beams %%%%%%%%%%%%%%%%%%
var zero1013SetPoint -0.01
%var ryd1013SetPoint 4.0 %4.0 %2.0

on: Ryd1013Shutter
ddsfreq: Ryd420Brimrose ryd420_resonance
t += 5
%on: Ryd420Shutter
off: Ryd420ExpShutter
%on: Ryd1013Shutter
on: ryd420RFSourceSwitch
off: ryd420AWGShapedChSwitch

dac: Ryd420Amp ryd420_amplitude %0.11 %0.11 %0.05 %0.2 %amplitude_scan %0.8 %0.1 %0.55 %0.30 %0.34
dac: Ryd1013Amp zero1013SetPoint %2.0 %0.55 %0.60 %0.68

var IQ_MAX_AMP 2.5
dac: MW_IQ_I IQ_MAX_AMP
dac: MW_IQ_Q 0
pulseon: MWTrg 0.4
t += 1

%%%%%%%%%%%%%%  Trap ramp for Rydberg  %%%%%%%%%%%%%%%%%%
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.02 10 %0.15
t += 10
%%%%% 420 sample and hold %%%%
%t += -10
%on: Ryd420Trg
%t += 3.0
%on: Ryd420Hold
%t += 1.0
%off: Ryd420Trg
%t += 0.1
%on: Ryd420ExpShutter
%t += 10-3-1-0.1
%%%%% 420 sample and hold %%%%
%%% 1013 sample and hold %%%%
%t += -10
%on: Ryd1013Trg
%t += 1
%dacramp: Ryd1013Amp zero1013SetPoint ryd1013_amplitude 4
%t += 6
%on: Ryd1013Hold
%t += 0.1
%off: Ryd1013Trg
%t += 10-6-1-0.1
%%% 1013 sample and hold %%%%
%%%%%%% ground state pushout with probe beam %%%%%
%t += -10
%on: PrbShutter
%on: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%off: OPShutter
%ol: ol_cooling d2_cooling_prb_resonance-(250) %-(-266.65)
%ol: ol_repump d2_repump_prb_resonance
%dac: PrbRepAmp 10 %10
%dac: PrbAmp {3 prb_pwr}
%off: PrbRepTrg
%off: PrbTrg
%t += 10
%%%%%%% ground state pushout with probe beam %%%%%
%%%%% ground state pushout with OP beam %%%%%
%t += -10
%on: PrbShutter
%on: OPShutter
%%off: PrbShutter
%%off: OPShutter
%
%off: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%off: TARepShutter
%ol: ol_cooling d2_cooling_resonance-(250) %-(-266.65)
%ol: ol_repump d2_repump_prb_resonance+150
%dac: PrbRepAmp 10
%dac: PrbAmp 8
%dac: OPAmp {3 op_pwr_high} %1
%off: PrbRepTrg
%off: PrbTrg
%off: OPTrg
%t += 10
%%%%% ground state pushout with OP beam %%%%%

%%%%%% ground state depump with probe beam %%%%%
t += -10
on: PrbShutter
on: PrbCoolShutter
%off: PrbShutter
%off: PrbCoolShutter

off: xyzMOTShutter
off: D1LGMShutter
off: D1LGMPrbShutter
off: OPShutter
ol: ol_cooling d2_cooling_prb_resonance-(-50) %-(-266.65)
ol: ol_repump d2_repump_prb_resonance+150
dac: PrbRepAmp -1
dac: PrbAmp {0.25 prb_pwr}
off: PrbRepTrg
off: PrbTrg
t += 10
%%%%%% ground state pushout with probe beam %%%%%


%on: ryd420RFSourceSwitch
t += 0.4
on: SLMTweezerHold
t += 0.101
off: SLMTweezerTrg


%t += -250/1000
%ol: ol_cooling d2_cooling_prb_resonance-(-266.65)
%ol: ol_repump d2_repump_prb_resonance+150
%t += 250/1000

t += -250/1000
ol: ol_cooling d2_cooling_prb_resonance-(-266.65)
ol: ol_repump d2_repump_prb_resonance+150
t += 250/1000

%t += time_scan


%off: SLMTweezerTrg
t += 20/1000-time_scan_us/1000
on: do8_4
on: PrbTrg
%on: PrbRepTrg
%on: OPTrg
t += time_scan_us/1000 %0.9/1000
%off: OPTrg
off: PrbTrg
off: PrbRepTrg
ol: ol_cooling d2_cooling_prb_resonance-(-50)
ol: ol_repump d2_repump_prb_resonance+150
off: do8_4
on: SLMTweezerTrg

t += 10/1000

t += 1/1000
%on: do8_4 
%on: MWAmpTrg
%on: SiglentTrg
t += -1/1000

on: SLMTweezerTrg

t += 0.01
%off: MWAmpTrg
%off: SiglentTrg
%off: do8_4 
t += -0.01

%t += -0.1
off: SLMTweezerHold
off: Ryd420Shutter
off: PrbShutter
on: PrbCoolShutter
off: OPShutter
on: TARepShutter
t += 0.1
dacramp: SLMTweezerIntensity slm_twz_intensity*0.02 slm_twz_intensity 10.08 %0.15
t += 10.08
%t += 0.1

t += -9
dacramp: Ryd1013Amp ryd1013_amplitude zero1013SetPoint 9
t += 9

%pulseon: MWAmpTrg 0.1
t += 0.1
off: Ryd1013Trg
off: Ryd1013Hold
off: Ryd1013Shutter
off: Ryd420Hold
t += 0.5

%%%%%%%%%%%%%%  End Rydberg  %%%%%%%%%%%%%%%%%%


t += 10
call StateSelectivePushout()
t += 10
%call setZeroField()

%    dac: BiasCoilX pgc_twz_bias_x
%    dac: BiasCoilY pgc_twz_bias_y 
%    dac: BiasCoilZ pgc_twz_bias_z
%t += 100
%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 10+t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 10
call RydbergBeamCameraFootprint()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
call EndSequence()
