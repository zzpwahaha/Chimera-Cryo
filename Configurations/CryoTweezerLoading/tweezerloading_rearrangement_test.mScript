%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()

t += -250-200 % 200 ms is for LGM loading/cooling

% SLM image
pulseon: Mako2 0.01
t += 1.1

pulseon: GMLoadTrg 0.0005
dac: TweezerIntensity twz_intensity
t += 1

% AOD full array image
pulseon: Mako2 0.01 
t += 0.2
pulseon: TweezerTrg 0.04
t += 1.1


% holding the tweezer at amplitude_scan
dac: TweezerIntensity 4.3/37*20 %4.3/37*15 %1.2 %5.5 %twz_intensity %amplitude_scan %6.5
t += 0.5
on: TweezerTrg
%pulseon: Mako2 0.01 
t += 150.2
on: TweezerHold
t += 0.1
off: TweezerTrg
t += 250+200-1.1-1-0.2-1.1-0.5-150.2-0.1


%%%%%%%%%%%%%%%  TOF  %%%%%%%%%%%%%%%%%%
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 15

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser fre q parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 15

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
%t += 15 

t += 80
%call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
%t += 15

    dac: BiasCoilX pgc_twz_bias_x
    dac: BiasCoilY pgc_twz_bias_y 
    dac: BiasCoilZ pgc_twz_bias_z

%%%%%%%%%%% PGC %%%%%%%%%%% 
    ol: ol_cooling d2_cooling_resonance+20-pgc_twz_olcool
    ol: ol_repump d2_repump_resonance-20+pgc_twz_olrepump
    on: PrbRepTrg
    on: PrbShutter
    on: PrbCoolShutter
    off: xyzMOTShutter
    dac: PrbAmp {pgcprb_twz_cool_amp_cal prb_pwr} 
    dac: PrbrepAmp 10 %pgcprb_twz_rep_amp
    t += t_shutter
%%%%%%%%%%% PGC %%%%%%%%%%% 

%%%%%%%%%%% LGM %%%%%%%%%%% 
%    off: xyzMOTShutter
%    on: D1LGMPrbShutter
%    off: D1LGMShutter
%    on: D1LGMEOMTrg
%    dac: D1LGMEOMAmp d1lgmprb_twz_rep_amp
%    dac: D1LGMAmp d1lgmprb_twz_cool_amp
%    ol: ol_D1LGM D1_LGMCooling_resonance-d1lgm_twz_olcool
%    ol: ol_D1_repump Rb87_HFSplitting+d1lgm_twz_olrepump
%    t += t_shutter
%%%%%%%%%%% LGM %%%%%%%%%%% 



%var SLM_depth 3.5
var rearrange_SLM_depth 5.8

%dacramp: SLMTweezerIntensity slm_twz_intensity SLM_depth 10
%t += 10


%t += 1

dacramp: SLMTweezerIntensity slm_twz_intensity rearrange_SLM_depth 10  %slm_twz_intensity*fraction_scan
t += 10

% this turns off RF tones from load2
t += -1
pulseon: GMMoveTrg 0.0005
t += 1
%on: TweezerTrg

%on: PrbTrg
%on: D1LGMTrg3
%pulseon: do8_4 0.1

%%%%%%%%% for euql/enough %%%%%%%%%
%repeat: 4
%t += 0.01
%% initialize tones
%pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
%t += 0.3
%
%% move tones
%on: PrbTrg
%t += 0.01
%on: TweezerTrg 
%t += 0.01
%pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
%t += 1
%off: TweezerTrg
%t += 0.01
%off: PrbTrg
%
%% ramp down tones
%pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
%t += 0.3
%end
%%%%%%%%% for euql/enough %%%%%%%%%


repeat: 5
t += 0.01
% initialize tones
pulseon: GMMoveTrg 0.0005
pulseon: do8_4 0.001
t += 0.3

% move tones
on: PrbTrg
t += 0.01
on: TweezerTrg 
t += 0.01
pulseon: GMMoveTrg 0.0005
pulseon: do8_4 0.001
t += 5
%t += time_scan
off: TweezerTrg
t += 0.01
off: PrbTrg

% ramp down tones
pulseon: GMMoveTrg 0.0005
pulseon: do8_4 0.001
t += 0.3
end

% after all rearrangement, this would turn off GM completely
%pulseon: GMMoveTrg 0.0005
off: TweezerTrg

off: PrbTrg
off: D1LGMTrg
off: D1LGMEOMTrg
off: PrbShutter
off: D1LGMPrbShutter
t += 1

off: PrbTrg
off: TweezerHold
pulseon: GMLoadTrg 0.0005


dacramp: SLMTweezerIntensity rearrange_SLM_depth slm_twz_intensity 10 %slm_twz_intensity*fraction_scan 
t += 10

t += 1
%dacramp: SLMTweezerIntensity SLM_depth slm_twz_intensity 10
%t += 10



%%%%%%%%%%%%%%%  second round of rearrangement  %%%%%%%%%%%%%%
%
%%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
%% change the field/laser freq parameter here because the previous section is TOF and no light is on
%call D2InTrapPGCPrb(25)
%% note the t_pgc_twz should be smaller than 100
%t += 15
%%%%%%%%%%%%%%%% Second Twizzer Image
%% note the previous section should have at least 4 ms dark interval
%call PGCTweezerImaging()
%
%t += 80
%    dac: BiasCoilX pgc_twz_bias_x
%    dac: BiasCoilY pgc_twz_bias_y 
%    dac: BiasCoilZ pgc_twz_bias_z
%%%%%%%%%%%% PGC %%%%%%%%%%% 
%    ol: ol_cooling d2_cooling_resonance+20-pgc_twz_olcool
%    ol: ol_repump d2_repump_resonance-20+pgc_twz_olrepump
%    on: PrbRepTrg
%    on: PrbShutter
%    on: PrbCoolShutter
%    off: xyzMOTShutter
%    dac: PrbAmp {pgcprb_twz_cool_amp_cal prb_pwr} 
%    dac: PrbrepAmp 10 %pgcprb_twz_rep_amp
%    t += t_shutter
%%%%%%%%%%%% PGC %%%%%%%%%%% 
%
%dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*fraction_scan 10
%t += 10
%
%% this turns off RF tones from load2
%t += -1
%pulseon: GMMoveTrg 0.0005
%t += 1
%%on: TweezerTrg
%
%
%repeat: 5
%t += 0.01
%% initialize tones
%pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
%t += 0.3
%
%% move tones
%on: PrbTrg
%t += 0.01
%on: TweezerTrg 
%t += 0.01
%pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
%t += 5
%%t += time_scan
%off: TweezerTrg
%t += 0.01
%off: PrbTrg
%
%% ramp down tones
%pulseon: GMMoveTrg 0.0005
%pulseon: do8_4 0.001
%t += 0.3
%end
%
%% after all rearrangement, this would turn off GM completely
%%pulseon: GMMoveTrg 0.0005
%off: TweezerTrg
%
%off: PrbTrg
%off: D1LGMTrg
%off: D1LGMEOMTrg
%off: PrbShutter
%off: D1LGMPrbShutter
%t += 1
%
%off: PrbTrg
%off: TweezerHold
%pulseon: GMLoadTrg 0.0005
%
%
%dacramp: SLMTweezerIntensity slm_twz_intensity*fraction_scan slm_twz_intensity 10
%t += 10
%%%%%%%%%%%%%%  second round of rearrangement  %%%%%%%%%%%%%%


%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 15
%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval
call PGCTweezerImaging()


%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
pulseon: DO1_0 0.5
