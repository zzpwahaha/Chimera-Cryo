%rearrange mode scrunchspacing amprate moverate 
% AmpIncr=1, Ramp from 0 to 100: 2**16*2**10/153.6MHz = 0.4369sec
% Frequency increment = 1  => 0.897 um/ms

%rearrange 1 tweezer1dinittest 1 2000 24 
%rearrange 1 enoughscrunchxtarget 1 2000 moverate 
%rearrange 2 centerscrunchx scrunchxtarget 1 2000 24 
%rearrange 1 scrunchxtarget 1 2000 24 %160 %24 %moverate 
%rearrange 1 filterscrunchxtarget 1 2000 24 %160 %24 %moverate 
rearrange 1 removefilterscrunchxtarget 1 2000 28 %27 %16 %23 %27 %165 %135 %24 %160 %24 %moverate 
%rearrange 1 centerscrunchx 1 2000 24 
%rearrange 1 centerscrunchx 1 amprate 50 
%rearrange 1 scrunchxtarget 1 1750 24 
%rearrange 1 scrunchxtarget 1 6000 50
%rearrange 1 centerscrunchx 1 6000 50 
%rearrange 1 scrunchx 1 6000 50 
singlex_repeatx 5
singlex_repeaty 3
singley_repeatx 1
singley_repeaty 6 %7

xoffset aod_offset_x %+frequency_scan %aod_dac0_freq
yoffset aod_offset_y %+frequency_scan %aod_dac1_freq


%loadx   11111111111111111111 %1W
%loady   11111 %1.6W

loadx   11111111111111111111 % 1W
loady   10000 %1.26W

%loadx   10000000000000000000 %1.28W
%loady   11111 %1.6W

%loadx   10000000000000000000 %1.28W
%loady   10000 %1.26W

