% pulse <pulse type> <vOffset> <amp> <pulse-width> <time-offset (ms)> <time(ms)> <Continuation Type> <Possibly Repeat #> <#>
%pulse gaussian 0.0 10.0 0.01 0.05 0.1 onceWaitTrig #

% window <pulse type> <vOffset> <amp> <transient-width> <window-width> <time-offset (ms)> <time(ms)> <Continuation Type> <Possibly Repeat #> <#>
window quadratic 0.0 10.0 0.1/1000 0.3/1000 0.5/1000 1/1000 onceWaitTrig #

%hold 0 0.01 onceWaitTrig #
%hold 5 0.01 onceWaitTrig #
%pulse gaussian 0.0 10.0 0.01 0.05 0.1 onceWaitTrig #
%hold 1 0.01 onceWaitTrig #
%hold 8 0.01 onceWaitTrig #
