%rearrange mode scrunchspacing amprate moverate 
% AmpIncr=1, Ramp from 0 to 100: 2**16*2**10/153.6MHz = 0.4369sec
% Frequency increment = 1  => 0.897 um/ms

%rearrange tweezer1dinittest 1 2000 24 
rearrange scrunchxtarget 1 2000 24 
%rearrange centerscrunchx 1 2000 24 
%rearrange centerscrunchx 1 amprate 50 
%rearrange scrunchxtarget 1 1750 24 
%rearrange scrunchxtarget 1 6000 50
%rearrange centerscrunchx 1 6000 50 
%rearrange scrunchx 1 6000 50 
singlex_repeatx 1
singlex_repeaty 1
singley_repeatx 1
singley_repeaty 7 %7

xoffset -0.036+(-0.07)+(0.0292) %frequency_scan %aod_dac0_freq
yoffset -0.05+0.06 %frequency_scan %aod_dac1_freq

loadx   1111111111111111111111111111111111111
%loadx   0000000000000111111111100000000000000 %10
%loadx   0000000000011111111111111100000000000 %15
%loadx   0000000011111111111111111111000000000 %20
loady   1


initx   1111111111111111111111111111111111111 %37
%initx   0000000011111111111111111111000000000 %20
%initx   0000000000011111111111111100000000000 % 15
%initx   0000000000000111111111100000000000000 %10
inity   1

%filterx 0000000000011111111111111100000000000
filterx 0000000000000111111111100000000000000 %10
filtery 1

paintx 0000000000000000001000000000000000000
painty 1

targetstart 
%0000000000001111111111111000000000000
%0000000000000001111110000000000000000 % 6
%0000000000000000001000000000000000000 % 1
%0000000011111111111111111111000000000 %20
0000000000111111111111111110000000000 %17
targetend 
%

% set DAC, channel, amp, freq, phase
%set DAC0 0 100 116.3 12
