%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
%call CryoMOTEnhancedLoadingLGM()

    call MOTLoadingAOD(t_loading)	
    call FreeSpaceLGMEnhancedLoading()


t += -250-200 % 200 ms is for LGM loading/cooling
% holding the tweezer at amplitude_scan
dac: SLMTweezerIntensity amplitude_scan %1
t += 0.5
on: SLMTweezerTrg
%pulseon: Mako2 0.01 
t += 150.2
on: SLMTweezerHold
t += 0.1
off: SLMTweezerTrg
t += 250+200-0.5-150.2-0.1


call TOF(10)

%t += -10
%dacramp: SLMTweezerIntensity 1.2 slm_twz_intensity 10
%t += 10

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
off: UVLampTrg
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 5

call setQuantizationField()
dacramp: TweezerIntensity twz_intensity twz_intensity*0.15 10
t += 10
t += t_field_settling-20
dacramp: TweezerIntensity twz_intensity*0.15 twz_intensity 10
t += 10

call OpticalPumping22()

%%change field to original OP befor angle
%t += 5
%    dac: BiasCoilX -2.5+0.75-2.5 
%    dac: BiasCoilY -0.839
%    dac: BiasCoilZ -0.048
%% warm
%dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
%t += 10
%t += 50-20
%dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
%t += 10


%%%%%%%%%%%%%%  Prepare Rydberg beams %%%%%%%%%%%%%%%%%%
var zero1013SetPoint -0.01
%var ryd1013SetPoint 4.0 %4.0 %2.0

on: Ryd1013Shutter
ddsfreq: Ryd420Brimrose ryd420_resonance
t += 5
%on: Ryd420Shutter
off: Ryd420ExpShutter
%on: Ryd1013Shutter
on: ryd420RFSourceSwitch
off: ryd420AWGShapedChSwitch

dac: Ryd420Amp ryd420_amplitude %0.11 %0.11 %0.05 %0.2 %amplitude_scan %0.8 %0.1 %0.55 %0.30 %0.34
dac: Ryd1013Amp zero1013SetPoint %2.0 %0.55 %0.60 %0.68

var IQ_MAX_AMP 2.5
dac: MW_IQ_I IQ_MAX_AMP
dac: MW_IQ_Q 0
pulseon: MWTrg 0.4
t += 1

%%%%%%%%%%%%%%  Trap ramp for Rydberg  %%%%%%%%%%%%%%%%%%
dacramp: TweezerIntensity twz_intensity twz_intensity*0.15 10
t += 10
%%%% 420 sample and hold %%%%
t += -10
on: Ryd420Trg
t += 3.0
on: Ryd420Hold
t += 1.0
off: Ryd420Trg
t += 0.1
on: Ryd420ExpShutter
t += 10-3-1-0.1
%%%% 420 sample and hold %%%%
%%%% 1013 sample and hold %%%%
t += -10
on: Ryd1013Trg
t += 1
dacramp: Ryd1013Amp zero1013SetPoint ryd1013_amplitude 4
t += 1
%on: Ryd1013Hold
t += 0.1
%off: Ryd1013Trg
t += 10-1-1-0.1
%%%% 1013 sample and hold %%%%

on: ryd420RFSourceSwitch
t += 0.4
on: TweezerHold
t += 0.101
off: TweezerTrg

%%% Ryd Rabi %%%%%%
t += 0.35/1000
t += -0.90/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%pulseon: Ryd1013Mako 10/1000
on: do8_4 %dummy trigger for picoscope
on: Ryd420Trg % scan to get Rabi
t += time_scan_us/1000
%t += (0.01+((sign(20.5-x)+1)/2)*0.01*x+((sign(x-20.5)+1)/2)*int(0.4*exp((x-21)*ln(1.076))*100)/100)/1000
off: Ryd420Trg
off: do8_4 
t += 0.90/1000
t += 0.35/1000
%%% Ryd Rabi %%%%%%

%%%%% Ryd Ramsey %%%%%%
%var Ryd_pi2_us 0.06
%%var Ryd_pi_us 0.1 %0.20 %0.185
%t += 0.35/1000
%t += -0.90/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi2_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += time_scan_us/1000
%
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi2_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += 0.90/1000
%t += 0.35/1000
%%%%% Ryd Ramsey %%%%%%

%%%%%%% Ryd pi wait Rydb pi lifetime %%%%%%
%var Ryd_pi_us 0.11
%%var Ryd_lifetime_t_total_us 12.4
%t += (time_scan_us+1.4)/1000
%t += -((time_scan_us+1.4)/2+Ryd_pi_us+time_scan_us/2)/1000
%
%%t += 0.35/1000
%t += -0.9/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%%pulseon: Ryd1013Mako 10/1000
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%
%t += 1.5/1000
%on: SLMTweezerTrg
%t += -1.5/1000
%
%t += time_scan_us/1000
%
%t += 0.4/1000
%off: SLMTweezerTrg
%t += -0.4/1000
%
%
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%%t += 0.35/1000
%t += 0.9/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%t += ((time_scan_us+1.4)/2-Ryd_pi_us-time_scan_us/2)/1000
%%%%%%% Ryd pi wait Rydb pi lifetime %%%%%%

%%%%%%% Ryd pi wait Rydb pi lifetime %%%%%%
%var Ryd_pi_us 0.10
%var Ryd_lifetime_t_total_us 12.4
%t += Ryd_lifetime_t_total_us/1000
%t += -(Ryd_lifetime_t_total_us/2+Ryd_pi_us+time_scan_us/2)/1000
%
%%t += 0.35/1000
%t += -0.9/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%%pulseon: Ryd1013Mako 10/1000
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%
%t += 1.5/1000
%on: SLMTweezerTrg
%t += -1.5/1000
%
%t += time_scan_us/1000
%
%t += 0.4/1000
%off: SLMTweezerTrg
%t += -0.4/1000
%
%
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%%t += 0.35/1000
%t += 0.9/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%t += (Ryd_lifetime_t_total_us/2-Ryd_pi_us-time_scan_us/2)/1000
%%%%%%% Ryd pi wait Rydb pi lifetime %%%%%%
%%%%%% Ryd pi MW Rydb pi %%%%%%
%var Ryd_pi_us 0.06
%var Ryd_lifetime_t_total_us 6.4
%t += 0.35/1000
%t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator
%
%t += Ryd_lifetime_t_total_us/1000
%t += -(Ryd_lifetime_t_total_us/2+Ryd_pi_us+time_scan_us/2+0.2)/1000
%
%pulseon: Ryd1013Mako 10/1000
%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%off: do8_4 
%
%t += 1.5/1000
%t += 0.2/1000
%on: do8_4 
%on: MWAmpTrg
%t += time_scan_us/1000
%off: MWAmpTrg
%off: do8_4 
%t += 0.2/1000
%t += -1.5/1000
%
%%on: do8_4 %dummy trigger for picoscope
%on: Ryd420Trg % scan to get Rabi
%t += Ryd_pi_us/1000
%off: Ryd420Trg
%%off: do8_4 
%
%t += (Ryd_lifetime_t_total_us/2-Ryd_pi_us-time_scan_us/2-0.2)/1000
%
%t += 0.95/1000
%t += 0.35/1000
%
%%%%%% Ryd pi MW Rydb pi %%%%%%


t += 1/1000
on: do8_4 
on: MWAmpTrg
on: SiglentTrg
t += -1/1000

on: TweezerTrg

t += 0.01
off: MWAmpTrg
off: SiglentTrg
off: do8_4 
t += -0.01

%t += -0.1
off: TweezerHold
dacramp: TweezerIntensity twz_intensity*0.15 twz_intensity 10.08
t += 10.08
%t += 0.1

t += -9
dacramp: Ryd1013Amp ryd1013_amplitude zero1013SetPoint 9
t += 9

%pulseon: MWAmpTrg 0.1
t += 0.1
off: Ryd1013Trg
off: Ryd1013Hold
off: Ryd420Shutter
off: Ryd1013Shutter
off: Ryd420Hold
t += 0.5

%%%%%%%%%%%%%%  End Rydberg  %%%%%%%%%%%%%%%%%%


t += 10
%call StateSelectivePushout(3.5)
%t += 10
%call setZeroField()

%    dac: BiasCoilX pgc_twz_bias_x
%    dac: BiasCoilY pgc_twz_bias_y 
%    dac: BiasCoilZ pgc_twz_bias_z
%t += 100
%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 10+t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 10
call RydbergBeamCameraFootprint()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
call EndSequence()
