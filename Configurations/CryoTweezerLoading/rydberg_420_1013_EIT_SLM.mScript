%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
off: UVLampTrg
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 5

call setQuantizationField()
%call setZeroField()
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
t += 10
t += t_field_settling-20
dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
t += 10

call OpticalPumping22()
%call PrepareF2Manifold()

%t += 5
%    dac: BiasCoilX -2.5+0.75-2.5 
%    dac: BiasCoilY -0.839+0.087
%    dac: BiasCoilZ -0.048+0.014 
%% warm
%dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
%t += 10
%t += 50-20
%dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
%t += 10

%%%%%%%%%%%%%%  Prepare Rydberg beams %%%%%%%%%%%%%%%%%%
var zero1013SetPoint -0.01
%var ryd1013SetPoint 2.0 %0.02 %2.0

var zero420SetPoint -0.013
%var ryd420SetPoint 0.1 %-0.01

on: Ryd1013Shutter
ddsfreq: Ryd420Brimrose ryd420_resonance %(14.13*fraction_scan+72.66) %ryd420_resonance
t += 5
%on: Ryd420Shutter
off: Ryd420ExpShutter
%on: Ryd1013Shutter
off: Ryd420AWGchswitch
dac: Ryd420Amp ryd420_amplitude %amplitude_scan %-0.01 %0.1 %0.55 %0.30 %0.34
dac: Ryd1013Amp zero1013SetPoint %2.0 %0.55 %0.60 %0.68

var IQ_MAX_AMP 2.5
dac: MW_IQ_I IQ_MAX_AMP
dac: MW_IQ_Q 0
pulseon: MWTrg 0.4
t += 1

%%%%%%%%%%%%%%  Trap ramp for Rydberg  %%%%%%%%%%%%%%%%%%
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*fraction_scan 10
t += 10

%%%% 420 sample and hold %%%%
t += -10
pulseon: Ryd420Mako 0.1
on: Ryd420Trg
t += 4.0
on: Ryd420Hold
t += 1.0
off: Ryd420Trg
t += 0.1
on: Ryd420ExpShutter
t += 10-4.0-1-0.1
%%%% 420 sample and hold %%%%

%%%%% Repump %%%%%
%t += -10
%on: PrbShutter
%off: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%off: OPShutter
%off: TARepShutter
%%ol: ol_cooling d2_cooling_resonance-(29-266.65)  %29
%ol: ol_repump d2_repump_prb_resonance+(3) %29
%dac: PrbRepAmp 8
%dac: PrbAmp 8
%t += 10
%%%%% Repump %%%%%

%%% OP %%%%%
%t += -10
%%on: PrbShutter
%off: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%on: OPShutter
%off: TARepShutter
%ol: ol_cooling d2_cooling_resonance-(fraction_scan*30-266.65)  %29
%ol: ol_repump d2_repump_prb_resonance+(fraction_scan*30) %29
%dac: PrbRepAmp 8
%dac: PrbAmp 8
%dac: OPAmp {0.1 op_pwr}
%t += 10
%%% OP %%%%%

%%%% OP without repump %%%%%
%t += -10
%off: PrbShutter
%off: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%on: OPShutter
%off: TARepShutter
%ol: ol_cooling d2_cooling_resonance-(fraction_scan*30-266.65) 
%%ol: ol_repump d2_repump_prb_resonance+(0.1*30) %29
%dac: PrbRepAmp 0
%dac: PrbAmp 0
%dac: OPAmp {0.7 op_pwr}
%t += 10
%%%% OP without repump  %%%%%

%%%%% OP push out %%%%%
%t += -10
%off: PrbShutter
%off: PrbCoolShutter
%off: xyzMOTShutter
%off: D1LGMShutter
%off: D1LGMPrbShutter
%on: OPShutter
%off: TARepShutter
%ol: ol_cooling d2_cooling_resonance-(resonance_scan)  %29
%%ol: ol_repump d2_repump_prb_resonance+(0.1*30) %29
%dac: PrbRepAmp 0
%dac: PrbAmp 0
%dac: OPAmp {0.1 op_pwr}
%t += 10
%%%%% OP push out %%%%%

%%%% D1 state transfer sample and hold %%%%
%t += -15
%dac: D1StateTransferAmp -1 %-3.0 %-1.0
%off: D1StateTransferShutter 
%t += 4
%on: D1StateTransferTrg
%t += 4
%on: D1StateTransferHold
%t += 0.1
%off: D1StateTransferTrg
%on: D1StateTransferShutter 
%t += 15-(4+4+0.1)
%%%% D1 state transfer sample and hold %%%%


%%%% 1013 sample and hold %%%%
t += -10
on: Ryd1013Trg
t += 1
dacramp: Ryd1013Amp zero1013SetPoint ryd1013_amplitude 4
t += 1
%on: Ryd1013Hold
t += 0.1
%off: Ryd1013Trg
t += 10-1-1-0.1
%%%% 1013 sample and hold %%%%

%var Ryd_pi2_us 0.09
%var Ryd_pi_us 0.09 %0.20 %0.185

%dac: Ryd420Amp zero420SetPoint
t += 0.5
on: SLMTweezerHold

%    %%%%% Rabi sequence with D1
%    t += 0.005 
%    on: D1StateTransferTrg
%    t += 16.89/1000
%    off: D1StateTransferTrg
%    t += 0.005
%    %%%%% Rabi sequence with D1




%%%%% Rabi %%%%%%
%on: PrbRepTrg
%on: PrbTrg
%on: OPTrg
t += 0.005
%off: SLMTweezerTrg
t += 0.35/1000

t += -0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator

%on: do8_4 %dummy trigger for picoscope
%%on: OPTrg
%on: Ryd420Trg % scan to get Rabi
%t += time_scan_us/1000 %time_scan
%off: Ryd420Trg
%%off: OPTrg
%off: do8_4 

on: do8_4 %dummy trigger for picoscope
t += -2/1000
on: SiglentTrg
t += 2/1000
on: Ryd420Trg 


%dacramp: Ryd420Amp zero420SetPoint ryd420SetPoint 0.06
%t += 0.06
t += time_scan
%dacramp: Ryd420Amp ryd420SetPoint zero420SetPoint 0.06
%t += 0.06
off: Ryd420Trg 
t += 2/1000
off: SiglentTrg
t += -2/1000
off: do8_4 %dummy trigger for picoscope


var pumping_interval 0.15 %1.5
var pumping_duration 0.05 %0.2

%t += -time_scan %-pumping_interval*int(time_scan/pumping_interval)
%repeat: int(time_scan/pumping_interval) 
%t += pumping_interval/2-pumping_duration/2
%on: OPTrg
%on: PrbTrg
%on: PrbRepTrg
%on: do8_4 
%t += pumping_duration
%off: do8_4 
%off: OPTrg
%off: PrbTrg
%off: PrbRepTrg
%t += pumping_interval/2-pumping_duration/2
%end
%t += -int(time_scan/pumping_interval)*pumping_interval  
%t += time_scan


t += 0.95/1000 %time for 420 AOM to turn since the beam is quite far away from the AOM actuator

t += 0.35/1000
on: SLMTweezerTrg

t += 0.005
off: OPTrg
off: PrbTrg
off: PrbRepTrg
off: PrbShutter
off: OPShutter
off: Ryd420ExpShutter
%t += time_scan
off: SLMTweezerHold
t += 0.5

%%%%%%%%%%%%%%% Release/recapture %%%%%%%%%%%%%%%%%
%call ReleaseRecaptureSLM(t_twz_release)
%%%%%%%%%%%%%%% Release/recapture %%%%%%%%%%%%%%%%%

dacramp: SLMTweezerIntensity slm_twz_intensity*fraction_scan slm_twz_intensity 10.08
t += 10.08
t += 0.1

t += -9
dacramp: Ryd1013Amp ryd1013_amplitude zero1013SetPoint 9
t += 9

%pulseon: MWAmpTrg 0.1
t += 0.1
off: Ryd1013Trg
off: Ryd1013Hold
off: Ryd420ExpShutter
off: Ryd1013Shutter
off: Ryd420Hold
t += 0.5

%%%%%%%%%%%%%%  End Rydberg  %%%%%%%%%%%%%%%%%%

t += 10
repeat: int(integer_scan_2)
call StateSelectivePushout()
end 
%call setZeroField()

%    dac: BiasCoilX pgc_twz_bias_x
%    dac: BiasCoilY pgc_twz_bias_y 
%    dac: BiasCoilZ pgc_twz_bias_z
%t += 100

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()

t += 10
call RydbergBeamCameraFootprint()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
pulseon: DO1_0 0.5
