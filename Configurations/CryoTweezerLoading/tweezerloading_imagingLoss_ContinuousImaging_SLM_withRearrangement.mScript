%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
call CryoMOTEnhancedLoadingLGM()

t += -250-200 % 200 ms is for LGM loading/cooling
% holding the tweezer at amplitude_scan
dac: TweezerIntensity 4.3/37*20 %4.3/37*15 %1.2 %5.5 %twz_intensity %amplitude_scan %6.5
t += 0.5
on: TweezerTrg
%pulseon: Mako2 0.01 
t += 150.2
on: TweezerHold
t += 0.1
off: TweezerTrg
t += 250+200-0.5-150.2-0.1


call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 15

call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 15

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()


%%%%%%%%%%%%%%  Rearrangment  %%%%%%%%%%%%%%%%%%
t += 50
    dac: BiasCoilX pgc_twz_bias_x
    dac: BiasCoilY pgc_twz_bias_y 
    dac: BiasCoilZ pgc_twz_bias_z
%%%%%%%%%%% PGC %%%%%%%%%%% 
    ol: ol_cooling d2_cooling_resonance+20-pgc_twz_olcool
    ol: ol_repump d2_repump_resonance-20+pgc_twz_olrepump
    on: PrbRepTrg
    on: PrbShutter
    on: PrbCoolShutter
    off: xyzMOTShutter
    dac: PrbAmp {pgcprb_twz_cool_amp_cal prb_pwr} 
    dac: PrbrepAmp 10 %pgcprb_twz_rep_amp
    t += t_shutter
%%%%%%%%%%% PGC %%%%%%%%%%% 

var rearrange_SLM_depth 5.8

dacramp: SLMTweezerIntensity slm_twz_intensity rearrange_SLM_depth 10  %slm_twz_intensity*fraction_scan
t += 10
% this turns off RF tones from load2
t += -1
pulseon: GMMoveTrg 0.0005
t += 1

repeat: 5
t += 0.01
% initialize tones
pulseon: GMMoveTrg 0.0005
pulseon: do8_4 0.001
t += 0.3

% move tones
on: PrbTrg
t += 0.01
on: TweezerTrg 
t += 0.01
pulseon: GMMoveTrg 0.0005
pulseon: do8_4 0.001
t += 3
%t += time_scan
off: TweezerTrg
t += 0.01
off: PrbTrg

% ramp down tones
pulseon: GMMoveTrg 0.0005
pulseon: do8_4 0.001
t += 0.3
end

% after all rearrangement, this would turn off GM completely
%pulseon: GMMoveTrg 0.0005
off: TweezerTrg

off: PrbTrg
off: D1LGMTrg
off: D1LGMEOMTrg
off: PrbShutter
off: D1LGMPrbShutter
t += 1

off: PrbTrg
off: TweezerHold
pulseon: GMLoadTrg 0.0005
dacramp: SLMTweezerIntensity rearrange_SLM_depth slm_twz_intensity 10 %slm_twz_intensity*fraction_scan 
t += 10
%%%%%%%%%%%%%%  Rearrangment  %%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
t += 10

%%%%%%%%%%%%%%% Prepare for pulsed PGC with Probe %%%%%%%%%%%%%%%
%%% turn off TA path and turn on Prb path for single beam cooling
%on: PrbCoolShutter
%off: TARepShutter
%off: xyMOTShutter
%
%off: PrbShutter
%off: xyzMOTShutter
%
%% wait 20 ms before cooling pulse 
%t += 10
%ol: ol_cooling d2_cooling_prb_resonance-probe_olcool %pgc_twz_olcool %probe_olcool
%ol: ol_repump d2_repump_prb_resonance+probe_olrepump %pgc_twz_olrepump %probe_olrepump
%
%%dac: BiasCoilX pgc_img_bias_x
%%dac: BiasCoilY pgc_img_bias_y
%%dac: BiasCoilZ pgc_img_bias_z
%
%%dac: BiasCoilX pgc_twz_bias_x
%%dac: BiasCoilY pgc_twz_bias_y
%%dac: BiasCoilZ pgc_twz_bias_z
%
%call setZeroField()
%%t += 100
%
%dac: PrbAmp {probe_cool_amp_cal prb_pwr} %{pgcprb_twz_cool_amp_cal prb_pwr} %{probe_cool_amp_cal prb_pwr}
%dac: PrbrepAmp probe_repump_amp %pgcprb_twz_rep_amp %probe_repump_amp
%    t += -t_shutter
%    on: PrbShutter
%    off: xyzMOTShutter
%    off: SciMOTTrg
%    t += t_shutter
%
%    t += -7
%    on: CameraShutter
%    t += 7
%%%%%%%%%%%%%%%% Pulsed PGC 5 times %%%%%%%%%%%%%%%
%%var t_cooling_cycle 2000/repeat_num
%var _wait_time_ 2000 %10000 %16000 %25*8*40 %20188 %20000 %20090 % 205*98=205*7*14
%var _total_time_btw_img_ 200 %25*8 %100 %98 % 14*7
%on: PrbTrg
%repeat: int(_wait_time_/_total_time_btw_img_) % repeat_num
%%    t += (t_cooling_cycle-5-5-t_pulsed_cool)/2
%%    t += (_wait_time_/repeat_num-5-5-t_twz_imaging)/2
%    pulseon: pixis_trg t_twz_imaging %t_pulsed_cool
%    pulseon: DO1_0 1
%    t += t_twz_imaging %t_pulsed_cool
%    t += _total_time_btw_img_-t_twz_imaging %t_pulsed_cool
%%    t += (_wait_time_/repeat_num-5-5-t_twz_imaging)/2
%end
%off: PrbTrg
%off: PrbShutter 
%
%    off: CameraShutter
%
%% 
%%t += t_wait_before_rr
%%%%%%%%%%%%%% turn probe cool shutter back on %%%%%%%%%%
%on: prbcoolshutter
%on: TARepShutter
%on: xyMOTShutter
%t += 5
%
%%call ReleaseRecapture(t_twz_release)
%t += 10
%call D2InTrapPGCPrb(t_pgc_twz)
%% note the t_pgc_twz should be smaller than 100
%t += 100-t_pgc_twz
%%%%%%%%%%%%%%%% Second Twizzer Image
%% note the previous section should have at least 4 ms dark interval
%%call PGCTweezerImaging()
%

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
pulseon: DO1_0 0.5
