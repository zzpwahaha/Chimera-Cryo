%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()

call CryoMOTEnhancedLoadingLGM()

%    call MOTLoadingAOD(t_loading)	
%    call FreeSpaceLGMEnhancedLoading()
%
%	call MOTLoadingAOD(t_loading)	
%	call FreeSpacePGC(t_pgc_cool_time)

call TOF(10)

%%%%%%%%%%%%%%%  TOF  %%%%%%%%%%%%%%%%%%
%call TOF(t_tof)

%dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.2 10
%t += 100
%
%dacramp: SLMTweezerIntensity slm_twz_intensity*0.2 slm_twz_intensity 10
%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on

%dacramp: SLMTweezerIntensity slm_twz_intensity 0.59 10
%t += 10


call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz


t += 10
%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
%on: MOTFlashTrg
%dacramp: TweezerIntensity twz_intensity twz_intensity*fraction_scan 10
%%t += 10
%t += time_scan %100
%dacramp: TweezerIntensity twz_intensity*fraction_scan twz_intensity 10
%t += 10
t += 100
%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz


call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()


%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
%pulseon: DO1_0 0.5
call EndSequence()

