%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
t += 15 %+500


t += 10

call setQuantizationField()
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
t += 10
t += t_field_settling-20
dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
t += 10

%%%%%%%%%%%%%% optical pumping into |2,2> state with 2-2'' OP, 1-2'' probe %%%%%%%%%%%
call OpticalPumping22()
t += 10

%%%%%%%%%%%%%%%%%% Brendan stupid code

% Make sure 420 stuff is off. Is this necesary? Why would it be on in the first place?
off: Ryd420Shutter
off: Ryd420ExpShutter

% Ramp down tweezer intensity? Why? Reduce disordered light shifts?
dacramp: SLMTweezerIntensity slm_twz_intensity slm_twz_intensity*0.1 10
t += 10

% Do some time travelling
t += -15

% Do state transfer beam sample and hold preparation
dac: D1StateTransferAmp -1.0
off: D1StateTransferShutter 
t += 4
on: D1StateTransferTrg
t += 4
on: D1StateTransferHold
t += 0.1
off: D1StateTransferTrg
on: D1StateTransferShutter 
t += 15-(4+4+0.1)

% Turn on the 1013 light (is this a good time to do it?)
dac: Ryd1013Amp 1.0 %amplitude_scan %1.0
on: Ryd1013Trg
t += 5

% trigger mako camera to record beam position
t += -1
pulseon: ryd1013Mako 0.1
t += 1

pulseon: do8_4 0.1 %dummy trigger for picoscope

% Start doing state transfer on the atoms
on: D1StateTransferTrg
t += time_scan_us/1000
off: D1StateTransferTrg
off: D1StateTransferHold

t += 1
off: D1StateTransferShutter 

% Turn the 1013 light off
dac: Ryd1013Amp 0.0 
off: Ryd1013Trg
t += 1

% Ramp tweezer strength back up
dacramp: SLMTweezerIntensity slm_twz_intensity*0.1 slm_twz_intensity 10
t += 10

% Wait longer(why?) and then do state selective imaging
t += 10
call StateSelectivePushout()

dac: BiasCoilX pgc_twz_bias_x
dac: BiasCoilY pgc_twz_bias_y 
dac: BiasCoilZ pgc_twz_bias_z
t += 100


%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 100-t_pgc_twz
%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval
call PGCTweezerImaging()

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
%call RydbergBeamCameraFootprint()
t += 10
pulseon: DO1_0 0.5
