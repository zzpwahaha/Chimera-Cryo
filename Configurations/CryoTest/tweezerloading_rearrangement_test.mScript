%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
%call CryoMOTLoadingPGC()
call CryoMOTEnhancedLoadingLGM()


%%%%%%%%%%%%%%%  TOF  %%%%%%%%%%%%%%%%%%
call TOF(10)

%%%%%%%%%%%%%%  PGC in Tweezer %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGC(t_pgc_twz)
% note the t_pgc_twz should be smaller than 100
t += 15

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser fre q parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 15

%%%%%%%%%%%%%%  Image TWIZZER  %%%%%%%%%%%%%%%%%%% change the field/laser freq parameter here because the previous section is dark, i.e. 100-t_pgc_twz is larger than 4
call PGCTweezerImaging()
t += 15 


    dac: BiasCoilX pgc_twz_bias_x
    dac: BiasCoilY pgc_twz_bias_y 
    dac: BiasCoilZ pgc_twz_bias_z
    on: PrbRepTrg
    ol: ol_cooling d2_cooling_resonance+20-pgc_twz_olcool
    ol: ol_repump d2_repump_resonance-20+pgc_twz_olrepump

t += 100

    on: PrbRepTrg
    on: PrbShutter
    on: PrbCoolShutter
    off: xyzMOTShutter
    dac: PrbAmp {pgcprb_twz_cool_amp_cal prb_pwr}
    dac: PrbrepAmp 10 %pgcprb_twz_rep_amp
    t += t_shutter


var SLM_depth 3.5

dacramp: SLMTweezerIntensity slm_twz_intensity SLM_depth 10
t += 10

% SLM image
pulseon: Mako2 0.01
t += 1.1

on: PrbTrg
pulseon: GMLoadTrg 0.0005
dac: TweezerIntensity 6.5
t += 1
on: TweezerTrg
t += 1 

%dacramp: TweezerIntensity 0 4.5 10
%t += 10


%t += 1
on: TweezerHold
t += 1

% AOD full array image
off: TweezerTrg
t += 0.1
pulseon: Mako2 0.01 
t += 0.2
pulseon: TweezerTrg 0.1
t += 1.1

t += 1

pulseon: GMMoveTrg 0.0005
t += 1
off: PrbTrg
on: TweezerTrg

dacramp: SLMTweezerIntensity SLM_depth SLM_depth*0.5 10
t += 10

pulseon: GMMoveTrg 0.0005
t += 0.1
on: PrbTrg
t += 1
pulseon: do8_4 1


pulseon: GMMoveTrg 0.0005
t += 2
off: PrbTrg

% after all rearrangement, this would turn off GM completely
pulseon: GMMoveTrg 0.0005

t += 1

t += 1
off: TweezerTrg
off: PrbTrg
off: TweezerHold
pulseon: GMLoadTrg 0.0005



dacramp: SLMTweezerIntensity SLM_depth*0.5 SLM_depth 10
t += 10

    t += 1
    pulseon: DO1_0 1
    off: PrbTrg
    off: PrbShutter 


t += 1
dacramp: SLMTweezerIntensity SLM_depth slm_twz_intensity 10
t += 10

%%%%%%%%%%%%%%  PGC in Tweezer with Probe %%%%%%%%%%%%%%%%%%
% change the field/laser freq parameter here because the previous section is TOF and no light is on
call D2InTrapPGCPrb(25)
% note the t_pgc_twz should be smaller than 100
t += 15
%%%%%%%%%%%%%%% Second Twizzer Image
% note the previous section should have at least 4 ms dark interval
call PGCTweezerImaging()


t += 10

repeat: 2
pulseon: GMMoveTrg 0.0005
t += 10
end



pulseon: GMMoveTrg 0.0005

%%%%%%%%%%%%%%  END Sequence  %%%%%%%%%%%%%%%%%%
t += 10
pulseon: DO1_0 0.5
