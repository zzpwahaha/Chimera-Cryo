%filterx 11011011011011011011 %10
%filterx 10000010000010000010
%filterx 10000000010000000001
%filterx 10000000011000000001
%filtery 00100

%filterx 11111110000011111111
%filterx 11111111000111111111
%filterx 11111100000000111111
filterx 11110000000000001111
%filterx 11111100000000000000
filtery 11111

%paintx 10010010010010010010
%paintx 00000000011000000000
paintx 00000000010000000000
%paintx 00000000000010000000
painty 00100

targetstart 

